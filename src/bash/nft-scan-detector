#!/bin/bash

# nft-scan-detector — (пере)створює таблицю inet scanDetector атомарно через nft -f.
#
# Працює в парі зі scan-detect-tool: обидва скрипти вважають файли в
# OVERRIDE_DIR єдиним джерелом правди для trusted/ignore/permanentBlock.
#
#   - Якщо override-файл існує (навіть порожній) — він ПОВНІСТЮ перекриває
#     відповідний BASE_* (це не merge, а заміна). BASE_* лишається лише
#     "заводським" значенням для першого запуску — далі скрипт його
#     нікуди не підмішує.
#   - scan-detect-tool є "власником" файлів: він додає/видаляє рядки і
#     одразу застосовує зміну наживо. При першому зверненні до списку,
#     що ще не має override-файлу, scan-detect-tool сам бутстрапить файл
#     поточним станом живого сету (тобто тими самими BASE_*, які цей
#     скрипт туди раніше поклав) — так дефолти не губляться.
#   - вся конфігурація формується в один буфер і застосовується ОДНІЄЮ
#     транзакцією (nft -c -f для перевірки синтаксису, потім nft -f) —
#     без escaping-пекла і без десятків окремих sudo-викликів;
#   - каскади level0..level15 / level6_0..level6_15 генеруються циклом
#     з масиву таймаутів, а не виписані вручну;
#   - інтерфейси docker-бриджів визначаються через `docker network inspect`.
#
# Live-стан (elements сетів scan/level*/srv_* та їхніх IPv6-відповідників):
# за замовчуванням перед `delete table` знімається знімок поточних елементів
# разом із рештою таймауту (nft -j + jq), а після перестворення сетів —
# відновлюється (`add element ... timeout <решта>s`) в тій самій транзакції.
# Прапорець --reset-live-state вимикає це і повертає стару поведінку —
# таблиця перестворюється з чистими сетами, як і всі ці 10+ років.
#
# Override-файли (по одному значенню на рядок, коментарі через #):
#   /etc/nft-scandetect/trusted-extra.list
#   /etc/nft-scandetect/ignore-extra.list
#   /etc/nft-scandetect/permanent-extra.list
#   /etc/nft-scandetect/trusted6-extra.list
#   /etc/nft-scandetect/ignore6-extra.list
#   /etc/nft-scandetect/permanent6-extra.list
#
# /etc/nft-scandetect/extra_forward_ifaces — той самий формат (по одному
# імені інтерфейсу на рядок), порожньо за замовчуванням. Транзитні (не
# docker) інтерфейси, які отримують ТІ САМІ forward-правила відстеження
# сканування, що й docker-бриджі (get_docker_bridges) -- напр. роутинг
# eno0<->eno1 без Docker узагалі. Редагується вручну, scan-detect-tool цим
# списком не керує.
#
# /etc/nft-scandetect/priority — окремий формат: РІВНО одне ціле число,
# без коментарів (читається через `head -1`). Пріоритет hook'ів input/forward
# (дефолт -50). Нелегітимне значення чи відсутній файл — фолбек на дефолт із
# попередженням у stderr. Керується вручну або через
# `scan-detect-tool --set-priority N`.
#
# /etc/nft-scandetect/table_name — той самий формат: РІВНО одна назва
# (легітимний nft-ідентифікатор), таблиця "<table_name>" замість
# заводського "scanDetector" (дефолт). Родина (inet) не конфігурується.
# Керується вручну або через `scan-detect-tool --set-table-name NAME` —
# на відміну від решти override-файлів, зміна назви таблиці прибирає й
# СТАРУ таблицю (nft не вміє її перейменувати "на місці").
#
# /etc/nft-scandetect/table_name_srv — той самий формат/логіка, для ДРУГОЇ
# table inet (дефолт "srvProtector"): захист протокол-груп (srv_*, "{ 80,
# 443 }" тощо) винесено в окрему таблицю, ІЗОЛЬОВАНУ від драбини
# ескалації level*/scan у ${DEFAULT_TABLE_NAME}. Причина розділення: дві
# логічно різні речі (довга, 31-денна репутація джерела супроти короткого
# per-порт rate/conn-лімітування) раніше жили в одній таблиці й
# перебудовувались РАЗОМ на кожному regen, хоча стан `meter` все одно
# завжди скидається (див. нижче), а стан `scan`/`level*` — цінний. Окрема
# таблиця дозволяє концептуально (і в перспективі -- операційно) керувати
# ними незалежно. Керується вручну або через
# `scan-detect-tool --set-table-name-srv NAME`.
#
# Пріоритет другої таблиці НЕ конфігурується окремим файлом -- він завжди
# РІВНО priority-1 (де priority -- ${OVERRIDE_DIR}/priority, спільний для
# обох). Це свідоме рішення, не недогляд: другий hook має спрацьовувати
# РАНІШЕ основного (менше число = вищий пріоритет в nftables), щоб
# srv_*-захист і далі відсікав джерело ДО того, як пакет дійде до драбини
# level*/scan -- так само, як це було в межах однієї таблиці до розділення
# (порядок правил). Довільних окремих пріоритетів для другої таблиці не
# передбачено -- саме "-1" без варіантів.
#
# /etc/nft-scandetect/<назва> (підкаталог) — ДОДАТКОВІ srv-протектор-подібні
# таблиці, окремо навіть від ${DEFAULT_TABLE_NAME_SRV}: наприклад, окрема,
# суворіша (менший rate, коротший over) таблиця лише для tcp/22, окремо від
# типової tcp/80+443. Кожен підкаталог -- окрема table inet, назва = ім'я
# каталогу (легітимний nft-ідентифікатор, інакше пропускається з
# попередженням; так само якщо збігається з ${DEFAULT_TABLE_NAME}/
# ${DEFAULT_TABLE_NAME_SRV}). Усередині -- РІВНО два файли того самого
# формату, що й у корені: srv_ports і srv_timeouts, і опційно priority
# (валідується: обов'язково МЕНШЕ за основний priority, інакше фолбек на
# priority-1 з попередженням). Trusted/ignore/permanentBlock/ipv6/
# level_timeouts/extra_forward_ifaces СВОГО файлу в підкаталозі НЕ мають --
# успадковуються з головного конфігу (${OVERRIDE_DIR}) без дублювання:
# дублювати їх сенсу нема (та сама довіра/ігнор скрізь), а от srv_ports/
# srv_timeouts/priority — саме те, заради чого ця додаткова таблиця й
# існує. Каталоги створюються вручну (`mkdir`), nft-scan-detector сам їх не
# створює -- лише досіює srv_ports/srv_timeouts, якщо їх ще нема всередині
# вже наявного каталогу. Див. discover_extra_srv_dirs/build_srv_table.
#
# /etc/nft-scandetect/ipv6 — той самий формат: РІВНО одне слово, 0/off,
# 1/on чи auto (дефолт auto). --no-ipv6 (прапорець) переважає цей файл для
# конкретного запуску. "auto" — sysctl (net.ipv6.conf.all.disable_ipv6) І
# реальна маршрутизована IPv6-адреса десь на хості (включно з lo).
#
# /etc/nft-scandetect/level_timeouts — рядки "N:timeout", СУЦІЛЬНО від 0 без
# пропусків/дублів (кількість рядків = кількість рівнів ескалації
# level0..levelN / level6_0..level6_N). Невалідний формат — фолбек на
# вбудований дефолт (16 рівнів, як завжди) з попередженням у stderr.
#
# /etc/nft-scandetect/srv_ports — рядки "proto/port" (tcp або udp), захищені
# порти для каскаду srv_*/srv6_* (дефолт tcp/80, tcp/443). Кілька портів
# одного протоколу йдуть в один dport-матч (одну "групу").
#
# /etc/nft-scandetect/srv_timeouts — рядки "stage:value", рівно 4 стадії:
# rate, burst, over, block (дефолт rate:20/minute burst:5 over:20 block:1m).
# Захист протокол-груп (tcp/80+443 тощо) побудований на nftables `meter`:
#   - over  -- meter з `ct count over N` -- скільки ОДНОЧАСНО відкритих
#     з'єднань з одного джерела допустимо;
#   - rate  -- meter з `limit rate` (token bucket) -- скільки НОВИХ з'єднань
#     за час допустимо, з дозволеним сплеском burst;
#   - block -- перевищення БУДЬ-ЯКОГО з двох meter'ів веде в спільний
#     (per-family) сет srv_block/srv6_block, timeout block, update на
#     кожній повторній спробі (не спадає передчасно, поки джерело намагається).
# ВАЖЛИВО: на відміну від srv_block/srv6_block (звичайний `set`, спільний
# для input і всіх forward-бриджів разом), nftables не дозволяє повторно
# використати той самий іменований `meter` у двох різних правилах -- тож
# rate/over-лічильники НЕЗАЛЕЖНІ для кожної (chain × bridge × протокол-група)
# комбінації (унікальне ім'я = prefix + монотонний лічильник SRV_METER_IDX,
# скидається на початку build_ruleset). Наслідок: джерело, що б'є одразу по
# кількох docker-бриджах, має окремий бюджет на кожен -- на відміну від
# старого сетового каскаду, де бюджет був геть спільний. Для типової
# інсталяції (один bridge чи взагалі --no-docker) різниці нема.
# Live-стан: srv_block/srv6_block -- звичайний `set` із `flags timeout`,
# підхоплюється capture/restore як завжди; стан самих meter'ів (rate/over)
# — НІ, бо в них `flags dynamic` без `timeout` (сам capture_live_state
# фільтрує саме на "timeout" у flags, а не на назву JSON-ключа -- байдуже,
# чи конкретна версія nft віддає meter під ключем "meter", чи як звичайний
# "set" з flags dynamic, як це почали робити новіші nft), тож лічильники
# скидаються на кожному regen/restart, а список уже заблокованих — ні.
# Неповний набір чи невідома стадія — фолбек на дефолт з попередженням у
# stderr. Детальний розбір і живі виміри — TESTS.md.
#
# --stop і live-стан: на відміну від звичайного перестворення (де знімок і
# відновлення відбуваються в одній транзакції), --stop лишає таблицю
# видаленою на невизначений час. Тому знімок перед видаленням лягає не лише
# в АУДИТ (${AUDIT_DIR}/live-state-<ts>.tsv), а й у фіксований "відкладений"
# файл ${AUDIT_DIR}/live-state-pending.tsv. Найперший наступний звичайний
# запуск (systemctl start/restart чи просто nft-scan-detector без прапорців)
# бачить цей файл, відновлює каскад із нього замість знімка живої таблиці
# (якої вже нема) і видаляє файл — одноразове споживання. --reset-live-state
# ігнорує й видаляє відкладений файл теж, не відновлюючи з нього.

set -euo pipefail

TABLE_FAMILY="inet"
OVERRIDE_DIR="/etc/nft-scandetect"
AUDIT_DIR="/var/lib/nft-scandetect"
PENDING_STATE_FILE="${AUDIT_DIR}/live-state-pending.tsv"
RESET_LIVE_STATE=0
NO_DOCKER=0
NO_IPV6=0
STOP_FWD=0
STOP_FWD_DOCKER=0
STOP_ALL=0
INIT=0
LIVE_STATE_FILE=""
SRV_PORT_GROUPS=""

# level0 = найдовший таймаут (найтерплячіший), level15 = найкоротший (щойно спіймали)
LEVEL_TIMEOUTS=(3h 2h30m 2h 1h30m 1h 50m 40m 30m 20m 15m 10m 5m 4m 3m 2m 1m)
LAST_LEVEL=$(( ${#LEVEL_TIMEOUTS[@]} - 1 ))   # 15

# scan/scan6 -- фінальний блок після найдовшого рівня (level0/level6_0),
# перевизначається опційним рядком "scan:timeout" у level_timeouts
DEFAULT_SCAN_TIMEOUT=31d

# srv_* -- ліміти захисту протокол-груп (див. gen_srv_rules): rate/burst --
# nftables `limit rate` (token bucket per-source), over -- `ct count over N`
# (макс. одночасних з'єднань per-source), block -- таймаут srv_block/srv6_block
# після перевищення будь-якого з двох. Перевірено емпірично на реальних TCP
# проти попереднього (сетового) каскаду -- і лагідніший до звичайного
# перегляду (короткий сплеск під burst не чіпає), і суворіший до стабільного
# швидкого потоку (якого сетовий каскад узагалі не бачив) -- див. TESTS.md.
SRV_LIMITS=(rate:20/minute burst:5 over:20 block:1m)
SRV_RATE="" SRV_BURST="" SRV_OVER="" SRV_BLOCK_TIMEOUT=""

# Монотонний лічильник -- унікальні імена meter (rl_N/over_N) у межах одної
# генерації; nftables не дозволяє повторно використати те саме ім'я meter у
# двох різних правилах (на відміну від set). Скидається на початку build_ruleset.
SRV_METER_IDX=0

# захищені порти для каскаду srv_*/srv6_* (те, що зараз "tcp dport { 80, 443 }")
SRV_PORTS_DEFAULT=(tcp/80 tcp/443)

# "Заводські" дефолти — застосовуються ТІЛЬКИ якщо відповідного
# override-файлу ще нема на диску (перший запуск / чиста система).
# Після появи файлу зміни в цей масив ігноруються — редагуйте файл
# або керуйте через scan-detect-tool.
BASE_TRUSTED="127.0.0.0/8"
BASE_IGNORE="0.0.0.0"
BASE_PERMANENT=""
BASE_IGNORE6="fe80::/64"
BASE_TRUSTED6="::1/128"
BASE_PERMANENT6=""

# Пріоритет hook'ів input/forward. Перевизначається файлом
# ${OVERRIDE_DIR}/priority (одне ціле число, керується вручну або через
# `scan-detect-tool --set-priority`) -- див. read_priority нижче.
DEFAULT_PRIORITY=-50

# Назва nft-таблиці (родина -- завжди TABLE_FAMILY, не конфігурується: inet
# потрібен для одночасних ip/ip6 правил в одній таблиці). Перевизначається
# файлом ${OVERRIDE_DIR}/table_name (керується вручну або через
# `scan-detect-tool --set-table-name`) -- див. read_table_name нижче.
DEFAULT_TABLE_NAME="scanDetector"

# Назва ДРУГОЇ nft-таблиці -- захист протокол-груп (srv_*), окремо від
# драбини level*/scan у ${DEFAULT_TABLE_NAME}. Перевизначається файлом
# ${OVERRIDE_DIR}/table_name_srv (керується вручну або через
# `scan-detect-tool --set-table-name-srv`) -- див. read_table_name_srv нижче.
DEFAULT_TABLE_NAME_SRV="srvProtector"

# Живий IPv6 -- перевіряємо через net.ipv6.conf.*.disable_ipv6 (0 -- увімкнено).
# Функції визначені тут, до usage()/розбору аргументів, бо автодетект --no-ipv6
# нижче звертається до ipv6_globally_enabled ще перед рештою визначень функцій.
ipv6_globally_enabled() {
    local f=/proc/sys/net/ipv6/conf/all/disable_ipv6
    [[ -r "$f" ]] && [[ "$(cat "$f" 2>/dev/null)" == "0" ]]
}

# per-bridge перевірка -- викликається лише коли глобально IPv6 уже увімкнено;
# відсутній sysctl-файл для інтерфейсу -- недостатньо підстав вважати IPv6
# робочим саме на ньому, тож трактуємо як вимкнений (безпечний дефолт).
# Навмисно НЕ вимагає реальної глобальної адреси на самому bridge (на
# відміну від ipv6_auto_detected_enabled нижче) -- docker-мережа могла б
# отримувати транзитний IPv6 і без власної адреси на bridge, топологій
# забагато, щоб бути тут категоричними; sysctl per-iface лишається
# єдиним (явним, адміністративним) сигналом на цьому рівні.
ipv6_enabled_for_iface() {
    local f="/proc/sys/net/ipv6/conf/${1}/disable_ipv6"
    [[ -r "$f" ]] && [[ "$(cat "$f" 2>/dev/null)" == "0" ]]
}

# "auto" з ${OVERRIDE_DIR}/ipv6 (глобальний рівень, не per-bridge):
# sysctl не вимкнений ГЛОБАЛЬНО, і (якщо є чим перевірити) десь на хості
# реально є маршрутизована (не link-local) IPv6-адреса -- включно з `lo`
# (там теж бувають "білі" адреси). Сам disable_ipv6=0 -- занадто слабкий
# сигнал: це стан практично будь-якого інтерфейса за замовчуванням
# (включно з щойно створеним docker-бриджем), а не доказ реальної
# IPv6-звʼязності. Без `ip` -- перевірити нічим, довіряємось sysctl.
ipv6_auto_detected_enabled() {
    ipv6_globally_enabled || return 1
    command -v ip >/dev/null 2>&1 || return 0
    ip -6 -o addr show scope global 2>/dev/null | grep -q .
}

# Читає ${OVERRIDE_DIR}/ipv6 -- РІВНО одне слово: "0"/"off" (завжди
# вимкнено), "1"/"on" (завжди увімкнено) чи "auto" (автовизначення,
# ipv6_auto_detected_enabled). Відсутній файл чи нелегітимний вміст -- те
# саме, що "auto" (з попередженням у другому випадку). Друкує "0" чи "1".
# Визначена тут (а не біля read_priority нижче), бо top-level автодетект
# --no-ipv6 звертається до неї ще до решти визначень функцій.
read_ipv6_mode() {
    local file="${OVERRIDE_DIR}/ipv6" raw
    if [[ -f "$file" ]]; then
        raw=$(head -1 "$file" | tr -d '[:space:]')
        case "$raw" in
            0|off) echo 0; return 0 ;;
            1|on) echo 1; return 0 ;;
            auto) : ;;
            *) echo "УВАГА: $file містить нелегітимне значення ('$raw', очікується 0/1/off/on/auto) -- використовую auto." >&2 ;;
        esac
    fi
    if ipv6_auto_detected_enabled; then echo 1; else echo 0; fi
}

# Читає ${OVERRIDE_DIR}/table_name -- РІВНО один рядок, легітимний
# nft-ідентифікатор (літери/цифри/підкреслення, не починається з цифри).
# Відсутній файл чи нелегітимний вміст -- фолбек на DEFAULT_TABLE_NAME (з
# попередженням у другому випадку). Визначена тут (до usage()/TABLE нижче),
# бо ${TABLE} мусить бути готовий ще до першого можливого виклику usage().
read_table_name() {
    local file="${OVERRIDE_DIR}/table_name" raw
    if [[ -f "$file" ]]; then
        raw=$(head -1 "$file" | tr -d '[:space:]')
        if [[ "$raw" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            echo "$raw"
            return 0
        fi
        echo "УВАГА: $file містить нелегітимну назву таблиці ('$raw') -- використовую дефолт ${DEFAULT_TABLE_NAME}." >&2
    fi
    echo "$DEFAULT_TABLE_NAME"
}

# Читає ${OVERRIDE_DIR}/table_name_srv -- той самий формат/фолбек-логіка, що
# й read_table_name вище, для другої таблиці (srv_*, дефолт "srvProtector").
read_table_name_srv() {
    local file="${OVERRIDE_DIR}/table_name_srv" raw
    if [[ -f "$file" ]]; then
        raw=$(head -1 "$file" | tr -d '[:space:]')
        if [[ "$raw" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            echo "$raw"
            return 0
        fi
        echo "УВАГА: $file містить нелегітимну назву таблиці ('$raw') -- використовую дефолт ${DEFAULT_TABLE_NAME_SRV}." >&2
    fi
    echo "$DEFAULT_TABLE_NAME_SRV"
}

TABLE="${TABLE_FAMILY} $(read_table_name)"
TABLE_SRV="${TABLE_FAMILY} $(read_table_name_srv)"

# Дві таблиці мають бути РІЗНИМИ nft-об'єктами -- однакова назва тут не
# "просто дублікат", а зіпсований ruleset (обидва блоки build_ruleset
# намагались би delete/add ту саму table). Перевіряємо одразу, до
# usage()/розбору аргументів -- жоден режим (build/--stop*/--init) не має
# сенсу з такою конфігурацією.
if [[ "$TABLE" == "$TABLE_SRV" ]]; then
    echo "Помилка: table_name і table_name_srv не можуть збігатися ('${TABLE#* }') -- потрібні дві різні назви таблиць." >&2
    exit 1
fi

# ---------------------------------------------------------------------------

usage() {
    cat <<EOF
Використання: $(basename "$0") [--reset-live-state] [--no-docker] [--no-ipv6]
       $(basename "$0") --stop-fwd | --stop-fwd-docker
       $(basename "$0") --stop
       $(basename "$0") --init

Звичайний режим (пере)генерує весь ruleset -- $(basename "$0") без окремих
режимів нижче (--stop-fwd*/--stop/--init):

  --reset-live-state   Не зберігати live-стан -- почати з чистих сетів
                        (стара поведінка: суцільний delete table без
                        відновлення). За замовчуванням live-стан
                        (scan/level0..level15 у ${TABLE#* }, srv_* у
                        ${TABLE_SRV#* } і в кожній додатковій srv-таблиці, і
                        IPv6-відповідники) переживає перестворення усіх
                        таблиць.
  --no-docker           Не підхоплювати docker-бриджі автоматично. Ланцюг
                        forward усе одно будується (в усіх таблицях), якщо
                        є хоч один інтерфейс з
                        ${OVERRIDE_DIR}/extra_forward_ifaces -- інакше
                        лишається тільки input. Активується й автоматично,
                        якщо бінарника docker немає на хості. Незалежний
                        від --reset-live-state -- прапорці вільно
                        комбінуються.
  --no-ipv6              Не генерувати жодних v6-сетів/правил (trusted6,
                        ignore6, permanentBlock6, level6_*, srv6_*, scan6,
                        ip6-правила в input і в кожному forward). Разовий
                        force-off для цього запуску -- переважає файл
                        ${OVERRIDE_DIR}/ipv6 нижче. Незалежно від
                        глобального стану, для кожного docker bridge
                        окремо ip6-правила forward пропускаються, якщо
                        саме на цьому bridge IPv6 вимкнено
                        (net.ipv6.conf.<bridge>.disable_ipv6=1) -- решта
                        бриджів це не зачіпає.

${OVERRIDE_DIR}/ipv6 -- постійне налаштування (рівно одне слово: 0/off,
1/on чи auto, дефолт auto), якщо --no-ipv6 не передано:
  0, off  завжди вимкнено (як --no-ipv6, але постійно, без прапорця)
  1, on   завжди увімкнено, незалежно від sysctl чи наявних адрес
  auto    автовизначення: net.ipv6.conf.all.disable_ipv6=0 (чи взагалі
          відсутній /proc/sys/net/ipv6 -- тоді вимкнено) І десь на хості
          (включно з lo) є реальна маршрутизована (не link-local) адреса

--stop-fwd / --stop-fwd-docker -- окремий режим, нічого не перегенеровує, а
лише знімає ланцюг forward з УСІХ живих таблиць (input, сети й live-стан
не чіпає в жодній). Корисно перед зупинкою Docker -- forward з великою
кількістю per-bridge правил заважає docker чисто "гаситись". Щоб повернути
forward -- достатньо звичайного запуску без окремих режимів.

  --stop-fwd            Зняти ланцюг forward в усіх таблицях, більше нічого
                        не робити.
  --stop-fwd-docker      Те саме, що --stop-fwd, і додатково зупинити
                        docker.socket та docker.service (у цьому порядку).

--stop -- прибирає УСІ відомі таблиці (${TABLE}, ${TABLE_SRV}, і кожну
додаткову srv-таблицю) із системи ПОВНІСТЮ (delete table: і input, і
forward, і всі сети, в кожній). Хост і docker-мережі після цього нічим не
захищені. Live-стан кожної таблиці перед видаленням зберігається в
${AUDIT_DIR}/live-state-pending.tsv і автоматично відновлюється при
першому наступному звичайному запуску (systemctl start/restart чи просто
nft-scan-detector без прапорців) -- незалежно від того, за скільки часу це
станеться. Це і є ExecStop у scan-detector.service: "systemctl stop
scan-detector.service" реально гасить усі таблиці, а не просто позначає
юніт неактивним.

  --stop                Повністю видалити усі відомі таблиці, більше нічого
                        не робити.

${OVERRIDE_DIR}/table_name / table_name_srv -- постійне налаштування
(рівно одна назва, легітимний nft-ідентифікатор на файл), дефолти
"scanDetector" і "srvProtector" відповідно. Родина (inet) не
конфігурується, і спільна для всіх таблиць. Керується вручну або через
scan-detect-tool --set-table-name NAME / --set-table-name-srv NAME (той
сеттер додатково прибирає СТАРУ таблицю під попередньою назвою -- nft не
вміє перейменувати "на місці"). Пріоритет ${TABLE_SRV#* } окремим файлом
не конфігурується -- завжди priority-1 (нижче число -- спрацьовує раніше),
див. ${OVERRIDE_DIR}/priority.

${OVERRIDE_DIR}/<назва> (підкаталог) -- ДОДАТКОВІ srv-протектор-подібні
таблиці, поза межами ${TABLE_SRV}: кожен підкаталог у ${OVERRIDE_DIR} --
окрема table inet "<назва>" (назва каталогу = легітимний nft-ідентифікатор,
інакше пропускається з попередженням; так само пропускається, якщо
збігається з ${TABLE#* }/${TABLE_SRV#* }). Усередині -- лише два файли,
srv_ports і srv_timeouts (той самий формат, що й у корені ${OVERRIDE_DIR}),
і опційний priority (те саме ціле число, обов'язково МЕНШЕ за основний
${OVERRIDE_DIR}/priority -- інакше фолбек на priority-1 з попередженням).
Решта -- trusted/ignore/permanentBlock/ipv6/level_timeouts/
extra_forward_ifaces -- УСПАДКОВУЄТЬСЯ з головного конфігу, власних
override-файлів для цього в підкаталозі нема. Каталоги створюються вручну
(`mkdir ${OVERRIDE_DIR}/<назва>`) -- nft-scan-detector сам їх не створює,
лише досіює відсутні srv_ports/srv_timeouts всередині вже наявних.

--init -- ще один окремий режим: лише сіє всі override-файли в
${OVERRIDE_DIR} вбудованими дефолтами, якщо їх ще нема (ті самі
seed_*_if_missing, що й перед звичайною генерацією). Живу таблицю,
Docker, live-стан не чіпає -- зручно, щоб проінспектувати/поправити
конфіги ДО першого реального запуску. Взаємовиключний з рештою прапорців.

  --init                Тільки досіяти відсутні override-файли, вийти.
  -h, --help            Ця довідка
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --reset-live-state) RESET_LIVE_STATE=1; shift ;;
        --no-docker) NO_DOCKER=1; shift ;;
        --no-ipv6) NO_IPV6=1; shift ;;
        --stop-fwd) STOP_FWD=1; shift ;;
        --stop-fwd-docker) STOP_FWD=1; STOP_FWD_DOCKER=1; shift ;;
        --stop) STOP_ALL=1; shift ;;
        --init) INIT=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "Невідома опція: $1" >&2; usage; exit 1 ;;
    esac
done

# --stop-fwd*/--stop/--init -- окремі режими: рівно один з них максимум, і
# жоден не комбінується з build-модифікаторами (--reset-live-state/--no-docker)
STANDALONE_MODES=0
[[ $STOP_FWD -eq 1 ]] && STANDALONE_MODES=$((STANDALONE_MODES + 1))
[[ $STOP_ALL -eq 1 ]] && STANDALONE_MODES=$((STANDALONE_MODES + 1))
[[ $INIT -eq 1 ]]     && STANDALONE_MODES=$((STANDALONE_MODES + 1))

if [[ $STANDALONE_MODES -gt 1 ]]; then
    echo "Помилка: --stop-fwd*/--stop/--init взаємовиключні між собою." >&2
    exit 1
fi

if [[ $STANDALONE_MODES -eq 1 && ( $RESET_LIVE_STATE -eq 1 || $NO_DOCKER -eq 1 || $NO_IPV6 -eq 1 ) ]]; then
    echo "Помилка: --stop-fwd*/--stop/--init не можна комбінувати з --reset-live-state/--no-docker/--no-ipv6." >&2
    exit 1
fi

# Docker відсутній на хості (не лише daemon недоступний, а самого бінарника
# нема) -- це стала, а не тимчасова умова, тож --no-docker вмикається сама
# собою, без потреби пам'ятати про прапорець. В окремих режимах це не має
# значення -- взагалі не чіпаємо docker тут.
if [[ $STANDALONE_MODES -eq 0 && $NO_DOCKER -eq 0 ]] && ! command -v docker >/dev/null 2>&1; then
    echo "Docker не знайдено на хості -- docker-бриджі автоматично не підхоплюються (як --no-docker); forward усе одно збудується, якщо є ${OVERRIDE_DIR}/extra_forward_ifaces." >&2
    NO_DOCKER=1
fi

# IPv6: --no-ipv6 (перевірено вище) -- разовий force-off, що переважає все
# інше. Якщо його не було -- рішення за ${OVERRIDE_DIR}/ipv6 (0/1/auto), де
# "auto" -- те саме автовизначення (sysctl + реальна адреса), що й раніше.
if [[ $STANDALONE_MODES -eq 0 && $NO_IPV6 -eq 0 ]] && [[ "$(read_ipv6_mode)" == "0" ]]; then
    echo "IPv6 не генерується (${OVERRIDE_DIR}/ipv6 чи автовизначення) -- v6-правила пропускаються." >&2
    NO_IPV6=1
fi

read_extra() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    # grep без збігів (файл лише з коментарями/порожній) виходить з кодом 1 —
    # це не помилка, а порожній список; `|| true` не дає pipefail завалити виклик
    (grep -vE '^\s*(#|$)' "$file" || true) | paste -sd, - | sed 's/,/, /g'
}

# list_elements BASE_DEFAULT EXTRA_FILE
# Якщо EXTRA_FILE існує — він ПОВНІСТЮ перекриває BASE_DEFAULT (не merge).
# Якщо файлу нема — використовується BASE_DEFAULT (перший запуск).
list_elements() {
    local base_default="$1" file="$2"
    if [[ -f "$file" ]]; then
        read_extra "$file"
    else
        echo "$base_default"
    fi
}

# seed_if_missing FILE BASE_DEFAULT_COMMA_SEPARATED
# Якщо файл ще не існує — створює його з BASE_* (по одному значенню на
# рядок), щоб scan-detect-tool у майбутньому мав що бутстрапити і щоб
# інспекція /etc/nft-scandetect одразу показувала актуальний стан, а не
# "порожньо, бо дефолти лежать десь у коді".
seed_if_missing() {
    local file="$1" base_default="$2"
    [[ -f "$file" ]] && return 0
    sudo mkdir -p "$OVERRIDE_DIR"
    {
        echo "# Автоматично створено nft-scan-detector $(date '+%Y-%m-%d %H:%M:%S') із заводських дефолтів."
        echo "# Цей файл тепер є джерелом правди для цього списку — керуйте через scan-detect-tool."
        if [[ -n "$base_default" ]]; then
            echo "$base_default" | tr ',' '\n' | sed 's/^ *//; s/ *$//'
        fi
    } | sudo tee "$file" >/dev/null
}

# ${OVERRIDE_DIR}/priority -- рівно одне ціле число, без коментарів (щоб
# read_priority міг обмежитись `head -1` і не парсити весь файл заради
# єдиного значення).
seed_priority_if_missing() {
    local file="${OVERRIDE_DIR}/priority"
    [[ -f "$file" ]] && return 0
    sudo mkdir -p "$OVERRIDE_DIR"
    echo "$DEFAULT_PRIORITY" | sudo tee "$file" >/dev/null
}

# ${OVERRIDE_DIR}/table_name -- той самий однорядковий формат, що й priority.
seed_table_name_if_missing() {
    local file="${OVERRIDE_DIR}/table_name"
    [[ -f "$file" ]] && return 0
    sudo mkdir -p "$OVERRIDE_DIR"
    echo "$DEFAULT_TABLE_NAME" | sudo tee "$file" >/dev/null
}

# ${OVERRIDE_DIR}/table_name_srv -- та сама логіка, для другої таблиці.
seed_table_name_srv_if_missing() {
    local file="${OVERRIDE_DIR}/table_name_srv"
    [[ -f "$file" ]] && return 0
    sudo mkdir -p "$OVERRIDE_DIR"
    echo "$DEFAULT_TABLE_NAME_SRV" | sudo tee "$file" >/dev/null
}

# ${OVERRIDE_DIR}/ipv6 -- рівно одне слово (0/1/auto), той самий формат, що
# й priority. Дефолт -- "auto" (те, що й було весь цей час: автовизначення).
seed_ipv6_mode_if_missing() {
    local file="${OVERRIDE_DIR}/ipv6"
    [[ -f "$file" ]] && return 0
    sudo mkdir -p "$OVERRIDE_DIR"
    echo "auto" | sudo tee "$file" >/dev/null
}

# Читає й валідує пріоритет з ${OVERRIDE_DIR}/priority. Нелегітимне значення
# (не ціле число) чи відсутній файл -- тихо (з попередженням у stderr) падає
# на DEFAULT_PRIORITY, а не ламає весь ruleset.
read_priority() {
    local file="${OVERRIDE_DIR}/priority" raw
    if [[ -f "$file" ]]; then
        raw=$(head -1 "$file")
        raw="${raw//[[:space:]]/}"
        if [[ "$raw" =~ ^-?[0-9]+$ ]]; then
            echo "$raw"
            return 0
        fi
        echo "УВАГА: $file містить нелегітимне значення пріоритету ('$raw') -- використовую дефолт ${DEFAULT_PRIORITY}." >&2
    fi
    echo "$DEFAULT_PRIORITY"
}

seed_level_timeouts_if_missing() {
    local file="${OVERRIDE_DIR}/level_timeouts"
    [[ -f "$file" ]] && return 0
    sudo mkdir -p "$OVERRIDE_DIR"
    {
        echo "# Автоматично створено nft-scan-detector $(date '+%Y-%m-%d %H:%M:%S') із вбудованих дефолтів."
        echo "# Формат: N:timeout, по одному рядку, суцільно від 0 без пропусків/дублів."
        echo "# Кількість рядків = кількість рівнів ескалації (level0..levelN / level6_0..level6_N)."
        echo "# Додатково -- щонайбільше один рядок scan:timeout: таймаут фінального"
        echo "# блоку scan/scan6 (куди потрапляють після найдовшого рівня, level0)."
        local i
        for i in "${!LEVEL_TIMEOUTS[@]}"; do
            echo "${i}:${LEVEL_TIMEOUTS[$i]}"
        done
        echo "scan:${DEFAULT_SCAN_TIMEOUT}"
    } | sudo tee "$file" >/dev/null
}

# Перевіряє, що LINES -- це рядки "N:timeout" (суцільні від 0 без
# пропусків/дублів, порядок рядків у файлі не важливий) плюс щонайбільше
# один додатковий рядок "scan:timeout".
validate_level_timeouts() {
    local lines="$1" line idx expected=0 scan_seen=0
    [[ -z "$lines" ]] && return 1
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        if [[ "$line" == scan:* ]]; then
            [[ "$line" =~ ^scan:[^:[:space:]]+$ ]] || return 1
            [[ $scan_seen -eq 1 ]] && return 1
            scan_seen=1
        else
            [[ "$line" =~ ^[0-9]+:[^:[:space:]]+$ ]] || return 1
        fi
    done <<< "$lines"
    while IFS= read -r idx; do
        idx="${idx%%:*}"
        [[ "$idx" -eq "$expected" ]] || return 1
        expected=$((expected + 1))
    done < <(printf '%s\n' "$lines" | grep -v '^scan:' | sort -t: -k1,1n)
    return 0
}

# Читає й валідує ${OVERRIDE_DIR}/level_timeouts, друкує ефективні "N:timeout"
# по рядку (без "scan:"), відсортовані за N. Невалідний формат чи відсутній
# файл -- попередження в stderr і вбудований дефолт (поточний LEVEL_TIMEOUTS).
read_level_timeouts() {
    local file="${OVERRIDE_DIR}/level_timeouts" lines
    if [[ -f "$file" ]]; then
        lines=$( (grep -vE '^\s*(#|$)' "$file" || true) | sed 's/[[:space:]]//g' )
        if validate_level_timeouts "$lines"; then
            printf '%s\n' "$lines" | grep -v '^scan:' | sort -t: -k1,1n
            return 0
        fi
        echo "УВАГА: $file має невалідний формат (потрібні суцільні рядки N:timeout від 0 без пропусків/дублів, і щонайбільше один рядок scan:timeout) -- використовую вбудований дефолт." >&2
    fi
    local i
    for i in "${!LEVEL_TIMEOUTS[@]}"; do
        echo "${i}:${LEVEL_TIMEOUTS[$i]}"
    done
}

# Читає той самий level_timeouts і повертає лише таймаут scan/scan6 --
# рядок "scan:timeout", якщо є й валідний, інакше DEFAULT_SCAN_TIMEOUT.
# Попередження про невалідний файл друкує read_level_timeouts (викликається
# поруч у build_ruleset) -- тут вдруге не дублюємо.
read_scan_timeout() {
    local file="${OVERRIDE_DIR}/level_timeouts" lines scan_line
    if [[ -f "$file" ]]; then
        lines=$( (grep -vE '^\s*(#|$)' "$file" || true) | sed 's/[[:space:]]//g' )
        if validate_level_timeouts "$lines"; then
            scan_line=$(printf '%s\n' "$lines" | grep '^scan:' || true)
            if [[ -n "$scan_line" ]]; then
                echo "${scan_line#scan:}"
                return 0
            fi
        fi
    fi
    echo "$DEFAULT_SCAN_TIMEOUT"
}

# seed_srv_ports_if_missing [SUBDIR] -- SUBDIR порожній для головної
# srv-таблиці (${OVERRIDE_DIR}/srv_ports), інакше -- для додаткової,
# каталог-зареєстрованої (${OVERRIDE_DIR}/SUBDIR/srv_ports), див.
# discover_extra_srv_dirs нижче.
seed_srv_ports_if_missing() {
    local subdir="${1:-}"
    local file="${OVERRIDE_DIR}/${subdir:+${subdir}/}srv_ports"
    [[ -f "$file" ]] && return 0
    sudo mkdir -p "$(dirname "$file")"
    {
        echo "# Автоматично створено nft-scan-detector $(date '+%Y-%m-%d %H:%M:%S') із вбудованих дефолтів."
        echo "# Формат: proto/port, по одному рядку (proto: tcp або udp)."
        printf '%s\n' "${SRV_PORTS_DEFAULT[@]}"
    } | sudo tee "$file" >/dev/null
}

# read_srv_port_groups [SUBDIR] -- читає ${OVERRIDE_DIR}/[SUBDIR/]srv_ports,
# групує по протоколу, друкує "proto:port1,port2,..." по рядку (один рядок
# на протокол). Невалідні окремі рядки пропускаються з попередженням; якщо
# після фільтрації не лишилось жодного валідного порту -- вбудований дефолт
# (SRV_PORTS_DEFAULT).
read_srv_port_groups() {
    local subdir="${1:-}"
    local file="${OVERRIDE_DIR}/${subdir:+${subdir}/}srv_ports" raw="" line proto port
    local -A by_proto=()

    [[ -f "$file" ]] && raw=$( (grep -vE '^\s*(#|$)' "$file" || true) | sed 's/[[:space:]]//g' )
    [[ -z "$raw" ]] && raw=$(printf '%s\n' "${SRV_PORTS_DEFAULT[@]}")

    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        if [[ "$line" =~ ^(tcp|udp)/([0-9]{1,5})$ ]]; then
            proto="${BASH_REMATCH[1]}"; port="${BASH_REMATCH[2]}"
            if (( port >= 1 && port <= 65535 )); then
                by_proto[$proto]+="${by_proto[$proto]:+,}${port}"
                continue
            fi
        fi
        echo "УВАГА: '$line' у $file не схоже на proto/port (tcp|udp/1..65535) -- пропускаю." >&2
    done <<< "$raw"

    if [[ ${#by_proto[@]} -eq 0 ]]; then
        echo "УВАГА: жодного валідного proto/port у $file -- використовую вбудований дефолт." >&2
        local d
        for d in "${SRV_PORTS_DEFAULT[@]}"; do
            proto="${d%%/*}"; port="${d##*/}"
            by_proto[$proto]+="${by_proto[$proto]:+,}${port}"
        done
    fi

    local p
    for p in "${!by_proto[@]}"; do
        echo "${p}:${by_proto[$p]}"
    done
}

# seed_srv_timeouts_if_missing [SUBDIR] -- та сама логіка, для srv_timeouts.
seed_srv_timeouts_if_missing() {
    local subdir="${1:-}"
    local file="${OVERRIDE_DIR}/${subdir:+${subdir}/}srv_timeouts"
    [[ -f "$file" ]] && return 0
    sudo mkdir -p "$(dirname "$file")"
    {
        echo "# Автоматично створено nft-scan-detector $(date '+%Y-%m-%d %H:%M:%S') із вбудованих дефолтів."
        echo "# Формат: stage:value, рівно 4 стадії: rate, burst, over, block."
        echo "# rate  -- nft 'limit rate', напр. 20/minute (нових з'єднань за час)."
        echo "# burst -- дозволений сплеск понад rate, у пакетах."
        echo "# over  -- nft 'ct count over N' (макс. одночасних з'єднань з джерела)."
        echo "# block -- таймаут блоку після перевищення rate чи over."
        printf '%s\n' "${SRV_LIMITS[@]}"
    } | sudo tee "$file" >/dev/null
}

# Перевіряє, що LINES -- це рядки "stage:value", де stage -- рівно
# rate/burst/over/block, кожна один раз (порядок не важливий).
validate_srv_timeouts() {
    local lines="$1" line
    local -A seen=()
    [[ -z "$lines" ]] && return 1
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        [[ "$line" =~ ^(rate|burst|over|block):[^:[:space:]]+$ ]] || return 1
        local stage="${line%%:*}"
        [[ -n "${seen[$stage]:-}" ]] && return 1
        seen[$stage]=1
    done <<< "$lines"
    [[ ${#seen[@]} -eq 4 ]]
}

# read_srv_timeouts [SUBDIR] -- та сама логіка, для srv_timeouts.
read_srv_timeouts() {
    local subdir="${1:-}"
    local file="${OVERRIDE_DIR}/${subdir:+${subdir}/}srv_timeouts" lines
    if [[ -f "$file" ]]; then
        lines=$( (grep -vE '^\s*(#|$)' "$file" || true) | sed 's/[[:space:]]//g' )
        if validate_srv_timeouts "$lines"; then
            printf '%s\n' "$lines"
            return 0
        fi
        echo "УВАГА: $file невалідний (потрібні рівно 4 стадії: rate/burst/over/block, кожна один раз) -- використовую вбудований дефолт." >&2
    fi
    printf '%s\n' "${SRV_LIMITS[@]}"
}

# read_extra_priority SUBDIR MAIN_PRIORITY -- пріоритет для ДОДАТКОВОЇ
# srv-таблиці з ${OVERRIDE_DIR}/SUBDIR/priority (рівно одне ціле число, той
# самий формат, що й головний priority). Гарантія "менше за основний"
# ВАЛІДУЄТЬСЯ тут: відсутній файл, нелегітимне значення, чи значення >=
# MAIN_PRIORITY -- фолбек на MAIN_PRIORITY-1 (той самий дефолт, що й у
# ${DEFAULT_TABLE_NAME_SRV}) з попередженням у другому й третьому випадку.
read_extra_priority() {
    local subdir="$1" main_priority="$2"
    local file="${OVERRIDE_DIR}/${subdir}/priority" raw fallback=$((main_priority - 1))
    if [[ -f "$file" ]]; then
        raw=$(head -1 "$file"); raw="${raw//[[:space:]]/}"
        if [[ "$raw" =~ ^-?[0-9]+$ ]]; then
            if (( raw < main_priority )); then
                echo "$raw"
                return 0
            fi
            echo "УВАГА: ${file} містить пріоритет ${raw}, не менший за основний (${main_priority}) -- використовую ${fallback}." >&2
        else
            echo "УВАГА: ${file} містить нелегітимне значення пріоритету ('$raw') -- використовую ${fallback}." >&2
        fi
    fi
    echo "$fallback"
}

# discover_extra_srv_dirs -- сканує ${OVERRIDE_DIR} на предмет підкаталогів
# (кожен -- ДОДАТКОВА srv-протектор-подібна таблиця, окрема від головної
# ${TABLE_SRV}: своя table inet <назва_каталогу>, свій priority/srv_ports/
# srv_timeouts; trusted/ignore/permanentBlock/ipv6/level_timeouts/
# extra_forward_ifaces УСПАДКОВУЮТЬСЯ з головного конфігу, свого файлу не
# мають). Друкує валідні назви (=basename каталогу) по рядку, відсортовано.
# Каталог пропускається (з попередженням) якщо назва не легітимний
# nft-ідентифікатор або збігається з ${TABLE_NAME}/${TABLE_NAME_SRV}.
# Результат КЕШУЄТЬСЯ (EXTRA_SRV_DIRS_CACHE) -- викликається по кілька разів
# за один прогін (seed_all_config_if_missing, build_ruleset, list_all_tables
# ×2 у main()), без кешу те саме попередження про кожен пропущений каталог
# друкувалось би в stderr стільки ж разів поспіль.
EXTRA_SRV_DIRS_CACHED=0
EXTRA_SRV_DIRS_CACHE=""
discover_extra_srv_dirs() {
    if [[ $EXTRA_SRV_DIRS_CACHED -eq 0 ]]; then
        local d name main_name srv_name result=""
        main_name="${TABLE#* }"
        srv_name="${TABLE_SRV#* }"
        if [[ -d "$OVERRIDE_DIR" ]]; then
            for d in "${OVERRIDE_DIR}"/*/; do
                [[ -d "$d" ]] || continue
                name="$(basename "$d")"
                if [[ ! "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
                    echo "УВАГА: каталог ${d} -- не легітимний nft-ідентифікатор, пропускаю як додаткову srv-таблицю." >&2
                    continue
                fi
                if [[ "$name" == "$main_name" || "$name" == "$srv_name" ]]; then
                    echo "УВАГА: каталог ${d} збігається з назвою вже наявної таблиці (${main_name}/${srv_name}), пропускаю." >&2
                    continue
                fi
                result+="${name}"$'\n'
            done
        fi
        EXTRA_SRV_DIRS_CACHE=$(printf '%s' "$result" | sort -u)
        EXTRA_SRV_DIRS_CACHED=1
    fi
    [[ -n "$EXTRA_SRV_DIRS_CACHE" ]] && printf '%s\n' "$EXTRA_SRV_DIRS_CACHE"
    return 0
}

# list_all_tables -- друкує повне "${TABLE_FAMILY} назва" по рядку для УСІХ
# відомих таблиць: ${TABLE}, ${TABLE_SRV}, і кожної додаткової srv-таблиці
# (discover_extra_srv_dirs). Єдине місце, де це перераховується -- do_stop_fwd/
# do_stop_all/main() (фінальний список) використовують саме його, щоб не
# дублювати перелік.
list_all_tables() {
    echo "${TABLE}"
    echo "${TABLE_SRV}"
    local extra_dir
    while IFS= read -r extra_dir; do
        [[ -z "$extra_dir" ]] && continue
        echo "${TABLE_FAMILY} ${extra_dir}"
    done < <(discover_extra_srv_dirs)
}

# Знімає елементи всіх dynamic/timeout сетів живої ТАБЛИЦІ (перший
# аргумент -- ${TABLE}, ${TABLE_SRV} чи одна з додаткових srv-таблиць:
# scan/level* живуть лише в ${TABLE}, srv_* -- у кожній srv-таблиці) разом
# із рештою таймауту -- ДОДАЄ у $LIVE_STATE_FILE (не перезаписує --
# викликається по разу на кожну відому таблицю в main()/do_stop_all() через
# list_all_tables, усі знімки лягають в один файл; колізій імен сетів між
# таблицями нема, тож однозначність за самою лише назвою зберігається), по
# рядку "назва_сету<TAB>значення<TAB>решта_секунд". Статичних interval-сетів
# (trusted/ignore/permanentBlock, тепер дубльованих в усіх таблицях) це не
# стосується -- вони йдуть через override-файли і в дамп не потрапляють (у
# них нема flags timeout).
capture_live_state() {
    local table="$1"
    [[ $RESET_LIVE_STATE -eq 1 ]] && return 0
    sudo nft -j list table ${table} 2>/dev/null | jq -r '
        .nftables[]? | select(.set?) | .set |
        select(.flags? and (.flags | index("timeout"))) |
        .name as $n |
        (.elem // [])[] |
        (($n) + "\t" + (.elem.val) + "\t" +
            (((.elem.expires // 1) | if . < 1 then 1 else . end) | tostring))
    ' >> "$LIVE_STATE_FILE" 2>/dev/null || true
}

# emit_restore TABLE SET_NAME -- якщо в знятому знімку є елементи для цього
# сету, друкує "add element TABLE SET_NAME { val1 timeout Ns, val2 timeout
# Ms }". Викликається одразу після відповідного "add set" -- в тій самій
# транзакції. TABLE явним аргументом (не глобальний ${TABLE}), бо тепер
# сети живуть у кількох різних таблицях (${TABLE} для scan/level*,
# ${TABLE_SRV} і додаткові srv-таблиці для srv_*) -- викликач сам знає, у
# контексті якої саме він зараз.
emit_restore() {
    local table="$1" set_name="$2"
    [[ -s "$LIVE_STATE_FILE" ]] || return 0
    local elems
    elems=$(awk -F'\t' -v s="$set_name" '
        $1 == s {
            if (n++) printf ", "
            printf "%s timeout %ss", $2, $3
        }
    ' "$LIVE_STATE_FILE")
    # явний return 0 в кінці -- інакше під `set -e` порожній $elems (звичайнісінький
    # випадок: для цього сету немає що відновлювати) повертає код 1 і мовчки
    # вбиває весь скрипт, бо emit_restore викликається як bare-statement
    [[ -n "$elems" ]] && echo "add element ${table} ${set_name} { ${elems} }"
    return 0
}

get_docker_bridges() {
    local netid name brname
    command -v docker >/dev/null 2>&1 || return 0
    docker network ls --filter driver=bridge -q 2>/dev/null | while read -r netid; do
        name=$(docker network inspect "$netid" --format '{{ .Name }}')
        [[ "$name" == "bridge" ]] && continue
        brname=$(docker network inspect "$netid" --format '{{ index .Options "com.docker.network.bridge.name" }}')
        [[ -z "$brname" ]] && brname="br-${netid}"
        if ip link show "$brname" &>/dev/null; then
            echo "$brname"
        else
            echo "УВАГА: $brname (мережа $name) очікувалась, але не знайдена в 'ip link'" >&2
        fi
    done | sort -u
}

# Читає ${OVERRIDE_DIR}/extra_forward_ifaces -- по одному імені інтерфейсу
# на рядок, коментарі через #. Це транзитні (не-docker) інтерфейси, які
# отримують ТІ САМІ forward-правила, що й docker-бриджі (та сама побудова
# ifm="iifname != IFACE oifname IFACE" у build_ruleset нижче) -- єдина
# відмінність від get_docker_bridges вище лише в джерелі списку. Неіснуючий
# інтерфейс -- попередження в stderr і пропуск, решта застосовується.
read_extra_forward_ifaces() {
    local file="${OVERRIDE_DIR}/extra_forward_ifaces" iface
    [[ -f "$file" ]] || return 0
    (grep -vE '^\s*(#|$)' "$file" || true) | sed 's/[[:space:]]//g' | while read -r iface; do
        [[ -z "$iface" ]] && continue
        if ip link show "$iface" &>/dev/null; then
            echo "$iface"
        else
            echo "УВАГА: інтерфейс '$iface' з ${file} не знайдено в 'ip link' -- пропускаю." >&2
        fi
    done
}

# --- генератори фрагментів nft-синтаксису ---

gen_level_sets() {
    # Завжди в ${TABLE} -- драбина level*/scan звідти нікуди не переїхала.
    local family="$1" prefix="$2"     # ipv4_addr|ipv6_addr ; level|level6_
    local i
    for i in "${!LEVEL_TIMEOUTS[@]}"; do
        echo "add set ${TABLE} ${prefix}${i} { type ${family}; size 65535; flags dynamic,timeout; timeout ${LEVEL_TIMEOUTS[$i]}; comment \"SynScan Level ${i}\"; }"
        emit_restore "${TABLE}" "${prefix}${i}"
    done
}

gen_srv_block_set() {
    # gen_srv_block_set TABLE FAMILY PREFIX -- TABLE тепер явний аргумент:
    # окрім головної ${TABLE_SRV}, те саме генерується й для кожної
    # додаткової srv-таблиці (discover_extra_srv_dirs), кожна своя, окрема
    # від драбини level*/scan, див. коментар на початку файлу.
    local table="$1" family="$2" prefix="$3"     # ipv4_addr|ipv6_addr ; srv_|srv6_
    echo "add set ${table} ${prefix}block { type ${family}; size 65535; flags dynamic,timeout; timeout ${SRV_BLOCK_TIMEOUT}; comment \"Service Block\"; }"
    emit_restore "${table}" "${prefix}block"
}

gen_srv_rules() {
    # gen_srv_rules TABLE CHAIN PROTO PREFIX L4MATCH IFACE_MATCH
    # L4MATCH -- напр. "tcp dport { 80, 443 }".
    #
    # Захист побудований на двох nftables `meter` (per-source token bucket
    # + per-source concurrent-connection cap) замість сетового каскаду
    # normal/check0/check1 -- див. TESTS.md за повним порівнянням і причиною.
    # Усе це живе в TABLE (окрема від level*/scan -- або головна ${TABLE_SRV},
    # або одна з додаткових srv-таблиць). srv_block/srv6_block лишається
    # звичайним `set`, СПІЛЬНИМ для всіх викликів gen_srv_rules у межах ОДНІЄЇ
    # TABLE (input, кожен forward-bridge, кожна протокол-група) -- той самий
    # "хто вже спійманий" список скрізь усередині цієї таблиці. А от rl_N/
    # over_N -- саме meter, і nftables не дозволяє повторне використання
    # того самого імені meter у двох різних правилах, тож кожен виклик
    # отримує СВІЙ, унікальний за SRV_METER_IDX -- rate/over-бюджет per
    # (chain × bridge × протокол-група), не спільний, як був у сетовому
    # каскаді.
    #
    # Перший рядок нижче -- permanentBlock, повторно, тепер ще й СКОПОВАНИЙ
    # на L4MATCH (на відміну від чейн-широкого permanentBlock-дропу в
    # gen_static_guard_rules, який спрацьовує РАНІШЕ й фактично вже ловить
    # усе). Не для захисту (той чейн-широкий рядок і так термінальний) --
    # для окремого, per-протокол-група лічильника: "скільки permanentBlock
    # трафіку прицільно било саме в захищені порти", той самий принцип
    # гранулярності, що й окремі копії guard-правил на кожен forward-бридж.
    local table="$1" chain="$2" proto="$3" prefix="$4" l4match="$5" ifm="${6:-}"
    local block="${prefix}block"
    local rl="${prefix}rl_${SRV_METER_IDX}" over="${prefix}over_${SRV_METER_IDX}"
    local permblock="permanentBlock"
    [[ "$proto" == "ip6" ]] && permblock="permanentBlock6"
    SRV_METER_IDX=$((SRV_METER_IDX + 1))
    echo "add rule ${table} ${chain} ${ifm}${l4match} ct state new ${proto} saddr @${permblock} counter drop"
    echo "add rule ${table} ${chain} ${ifm}${l4match} ct state new ${proto} saddr @${block} update @${block} { ${proto} saddr } counter drop"
    echo "add rule ${table} ${chain} ${ifm}${l4match} ct state new meter ${over} { ${proto} saddr ct count over ${SRV_OVER} } add @${block} { ${proto} saddr } counter drop"
    echo "add rule ${table} ${chain} ${ifm}${l4match} ct state new meter ${rl} { ${proto} saddr limit rate ${SRV_RATE} burst ${SRV_BURST} packets } counter return"
    echo "add rule ${table} ${chain} ${ifm}${l4match} ct state new ${proto} saddr != @${block} add @${block} { ${proto} saddr } counter drop"
}

# gen_srv_rules_all_ports TABLE CHAIN PROTO PREFIX IFACE_MATCH -- викликає
# gen_srv_rules по разу на кожну протокол-групу з $SRV_PORT_GROUPS
# ("proto:port1,port2" по рядку, див. read_srv_port_groups).
gen_srv_rules_all_ports() {
    local table="$1" chain="$2" proto="$3" prefix="$4" ifm="${5:-}"
    local group l4proto ports
    while IFS= read -r group; do
        [[ -z "$group" ]] && continue
        l4proto="${group%%:*}"
        ports="${group#*:}"
        gen_srv_rules "$table" "$chain" "$proto" "$prefix" "${l4proto} dport { ${ports} }" "$ifm"
    done <<< "$SRV_PORT_GROUPS"
}

gen_level_rules() {
    # gen_level_rules CHAIN PROTO PREFIX SCAN_SET IFACE_MATCH
    local chain="$1" proto="$2" prefix="$3" scan="$4" ifm="${5:-}"
    local i next

    echo "add rule ${TABLE} ${chain} ${ifm}ct state new ${proto} saddr != @${scan} ${proto} saddr @${prefix}0 add @${scan} { ${proto} saddr } counter"

    for ((i = 0; i < LAST_LEVEL; i++)); do
        next=$((i + 1))
        echo "add rule ${TABLE} ${chain} ${ifm}ct state new ${proto} saddr != @${prefix}${i} ${proto} saddr @${prefix}${next} add @${prefix}${i} { ${proto} saddr } counter"
    done

    echo "add rule ${TABLE} ${chain} ${ifm}ct state new ${proto} saddr != @${prefix}${LAST_LEVEL} add @${prefix}${LAST_LEVEL} { ${proto} saddr } counter"
    echo "add rule ${TABLE} ${chain} ${ifm}ct state new ${proto} saddr @${scan} update @${scan} { ${proto} saddr } counter log prefix \"[nft] scandetect-${chain}-drop \" drop"
    echo "add rule ${TABLE} ${chain} ${ifm}${proto} saddr @${scan} update @${scan} { ${proto} saddr } counter log prefix \"[nft] scandetect-${chain}-another-drop \" drop"
}

gen_static_guard_rules() {
    # permanentBlock / trusted / ignore -- для input (без iface-match) чи
    # forward (з ним). TABLE явним аргументом -- ці три сети тепер
    # ДУБЛЬОВАНІ в УСІХ таблицях (${TABLE}, ${TABLE_SRV} і кожна додаткова
    # srv-таблиця), кожна зі своїм `return`, що виходить лише з ВЛАСНОГО
    # chain (nftables не пропускає інші table/chain на тому самому hook
    # через return однієї з них) -- тож "довіру"/"ігнор" правильно
    # спрацьовує в кожній незалежно.
    local table="$1" chain="$2" ifm="${3:-}"
    echo "add rule ${table} ${chain} ${ifm}ip saddr @permanentBlock counter drop"
    echo "add rule ${table} ${chain} ${ifm}ct state new ip saddr @trusted counter return"
    echo "add rule ${table} ${chain} ${ifm}ct state new ip saddr @ignore counter return"
}

gen_static_guard6_rules() {
    # permanentBlock6 / trusted6 / ignore6 -- та сама логіка, TABLE явним аргументом.
    local table="$1" chain="$2" ifm="${3:-}"
    echo "add rule ${table} ${chain} ${ifm}ip6 saddr @permanentBlock6 counter drop"
    echo "add rule ${table} ${chain} ${ifm}ct state new ip6 saddr @trusted6 counter return"
    echo "add rule ${table} ${chain} ${ifm}ct state new ip6 saddr @ignore6 counter return"
}

# ${OVERRIDE_DIR}/extra_forward_ifaces -- порожньо за замовчуванням (немає
# заводських фізичних інтерфейсів, на відміну від trusted/ignore). Формат
# той самий, що й в extra.list -- по одному значенню (тут: імені
# інтерфейсу) на рядок, коментарі через #. Власний seed (не generic
# seed_if_missing) -- той пише "керуйте через scan-detect-tool", а цей файл
# редагується вручну, scan-detect-tool ним не керує.
seed_extra_forward_ifaces_if_missing() {
    local file="${OVERRIDE_DIR}/extra_forward_ifaces"
    [[ -f "$file" ]] && return 0
    sudo mkdir -p "$OVERRIDE_DIR"
    {
        echo "# Автоматично створено nft-scan-detector $(date '+%Y-%m-%d %H:%M:%S')."
        echo "# Порожньо за замовчуванням. forward-правила scanDetector -- це відстеження"
        echo "# ТРАНЗИТНОГО трафіку на потенційне сканування (той самий принцип, що й для"
        echo "# input), а не дозвіл/заборона transit-трафіку як такого (те -- окрема"
        echo "# турбота іншого hook'а/таблиці, див. README). За замовчуванням транзитні"
        echo "# інтерфейси беруться лише з docker-мереж (get_docker_bridges). Щоб додати"
        echo "# під той самий захист ще й фізичні (не-docker) інтерфейси -- напр. роутинг"
        echo "# eno0 <-> eno1 без Docker узагалі -- по одному імені інтерфейсу на рядок."
        echo "# Кожен отримує ідентичні forward-правила, що й docker-бридж. Редагується"
        echo "# вручну -- scan-detect-tool цим списком не керує."
    } | sudo tee "$file" >/dev/null
}

# Сіє всі override-файли, яких ще нема, вбудованими дефолтами -- щоб
# /etc/nft-scandetect завжди відображав актуальний стан, а не приховані в
# коді дефолти. Спільна для build_ruleset (перед генерацією) і --init
# (самостійно, без генерації) -- щоб не дублювати список викликів.
seed_all_config_if_missing() {
    seed_if_missing "${OVERRIDE_DIR}/trusted-extra.list"    "$BASE_TRUSTED"
    seed_if_missing "${OVERRIDE_DIR}/ignore-extra.list"     "$BASE_IGNORE"
    seed_if_missing "${OVERRIDE_DIR}/permanent-extra.list"  "$BASE_PERMANENT"
    seed_if_missing "${OVERRIDE_DIR}/trusted6-extra.list"   "$BASE_TRUSTED6"
    seed_if_missing "${OVERRIDE_DIR}/ignore6-extra.list"    "$BASE_IGNORE6"
    seed_if_missing "${OVERRIDE_DIR}/permanent6-extra.list" "$BASE_PERMANENT6"
    seed_priority_if_missing
    seed_table_name_if_missing
    seed_table_name_srv_if_missing
    seed_ipv6_mode_if_missing
    seed_level_timeouts_if_missing
    seed_srv_ports_if_missing
    seed_srv_timeouts_if_missing
    seed_extra_forward_ifaces_if_missing

    # Додаткові srv-таблиці -- каталоги вже мусять існувати (адмін створює
    # їх сам, `mkdir /etc/nft-scandetect/<назва>`); тут лише досіюємо
    # відсутні srv_ports/srv_timeouts УСЕРЕДИНІ вже наявних каталогів, самі
    # каталоги не створюємо.
    local extra_dir
    while IFS= read -r extra_dir; do
        [[ -z "$extra_dir" ]] && continue
        seed_srv_ports_if_missing "$extra_dir"
        seed_srv_timeouts_if_missing "$extra_dir"
    done < <(discover_extra_srv_dirs)
}

# build_srv_table TABLE SUBDIR PRIORITY -- генерує повний ruleset ОДНІЄЇ
# srv-протектор-подібної таблиці (delete+add table, статичні сети,
# srv_block(6), chain'и input/forward із захистом протокол-груп). TABLE --
# повне "${TABLE_FAMILY} назва". SUBDIR -- порожньо для головної ${TABLE_SRV}
# (srv_ports/srv_timeouts у корені ${OVERRIDE_DIR}), інакше -- назва
# каталогу під ${OVERRIDE_DIR} (для додаткових таблиць,
# discover_extra_srv_dirs) -- srv_ports/srv_timeouts читаються звідти,
# решта (trusted/ignore/permanent(6)/forward_ifaces/NO_IPV6) успадковується
# з глобальних змінних build_ruleset (той самий патерн, що й SRV_RATE/
# SRV_BURST/тощо, які так само глобальні для gen_srv_rules) -- жодних
# власних override-файлів для цього в додаткової таблиці нема.
build_srv_table() {
    local table="$1" subdir="$2" tbl_priority="$3"

    local srv_lines st_line
    srv_lines=$(read_srv_timeouts "$subdir")
    while IFS= read -r st_line; do
        [[ -z "$st_line" ]] && continue
        case "${st_line%%:*}" in
            rate)  SRV_RATE="${st_line#*:}" ;;
            burst) SRV_BURST="${st_line#*:}" ;;
            over)  SRV_OVER="${st_line#*:}" ;;
            block) SRV_BLOCK_TIMEOUT="${st_line#*:}" ;;
        esac
    done <<< "$srv_lines"
    SRV_METER_IDX=0
    SRV_PORT_GROUPS=$(read_srv_port_groups "$subdir")

    # "add table" перед "delete table" -- та сама причина, що й для ${TABLE}
    # вище (гарантія існування на момент видалення).
    echo "add table ${table}"
    echo "delete table ${table}"
    echo "add table ${table}"

    echo "add set ${table} trusted { type ipv4_addr; flags interval; auto-merge; comment \"Trusted Sources\"; }"
    [[ -n "$trusted" ]] && echo "add element ${table} trusted { ${trusted} }"
    echo "add set ${table} ignore { type ipv4_addr; flags interval; auto-merge; comment \"Excluded Sources\"; }"
    [[ -n "$ignore" ]] && echo "add element ${table} ignore { ${ignore} }"
    echo "add set ${table} permanentBlock { type ipv4_addr; flags interval; auto-merge; comment \"Permanent Block\"; }"
    [[ -n "$permanent" ]] && echo "add element ${table} permanentBlock { ${permanent} }"

    if [[ $NO_IPV6 -eq 0 ]]; then
        echo "add set ${table} trusted6 { type ipv6_addr; flags interval; auto-merge; comment \"Trusted Sources\"; }"
        [[ -n "$trusted6" ]] && echo "add element ${table} trusted6 { ${trusted6} }"
        echo "add set ${table} ignore6 { type ipv6_addr; flags interval; auto-merge; comment \"Excluded Sources\"; }"
        [[ -n "$ignore6" ]] && echo "add element ${table} ignore6 { ${ignore6} }"
        echo "add set ${table} permanentBlock6 { type ipv6_addr; flags interval; auto-merge; comment \"Permanent Block\"; }"
        [[ -n "$permanent6" ]] && echo "add element ${table} permanentBlock6 { ${permanent6} }"
        gen_srv_block_set "$table" ipv6_addr srv6_
    fi

    gen_srv_block_set "$table" ipv4_addr srv_

    echo "add chain ${table} input { type filter hook input priority ${tbl_priority}; }"

    gen_static_guard_rules "$table" input
    gen_srv_rules_all_ports "$table" input ip srv_

    if [[ $NO_IPV6 -eq 0 ]]; then
        gen_static_guard6_rules "$table" input
        gen_srv_rules_all_ports "$table" input ip6 srv6_
    fi

    if [[ -n "$forward_ifaces" ]]; then
        echo "add chain ${table} forward { type filter hook forward priority ${tbl_priority}; }"

        local iface ifm
        while read -r iface; do
            [[ -z "$iface" ]] && continue
            ifm="iifname != ${iface} oifname ${iface} "

            gen_static_guard_rules "$table" forward "$ifm"
            gen_srv_rules_all_ports "$table" forward ip srv_ "$ifm"

            if [[ $NO_IPV6 -eq 0 ]] && ipv6_enabled_for_iface "$iface"; then
                gen_static_guard6_rules "$table" forward "$ifm"
                gen_srv_rules_all_ports "$table" forward ip6 srv6_ "$ifm"
            fi
        done <<< "$forward_ifaces"
    fi
}

# --- побудова повного ruleset ---

build_ruleset() {
    seed_all_config_if_missing

    # НЕ local: trusted/ignore/permanent(6)/forward_ifaces читаються ще й
    # у build_srv_table нижче (окрема функція, викликається для ${TABLE_SRV}
    # і для кожної додаткової srv-таблиці) -- той самий патерн, що й
    # SRV_RATE/SRV_BURST/тощо, які так само глобальні й читаються
    # gen_srv_rules. priority лишається local -- потрібен лише тут.
    local priority srv_priority
    priority=$(read_priority)
    # ${TABLE_SRV} завжди на priority-1 -- нижче число, спрацьовує РАНІШЕ
    # ${TABLE}, щоб srv_* і далі відсікав джерело до того, як пакет дійде до
    # драбини level*/scan (той самий ефект, що й порядок правил у межах
    # однієї таблиці до розділення). Без окремого override-файлу, без варіантів.
    srv_priority=$((priority - 1))

    # ефективна драбина рівнів -- з level_timeouts, якщо валідний, інакше
    # вбудований дефолт; gen_level_sets/gen_level_rules нижче далі просто
    # читають LEVEL_TIMEOUTS/LAST_LEVEL, змін у них не треба
    local level_lines lt_line lt_idx scan_timeout
    level_lines=$(read_level_timeouts)
    LEVEL_TIMEOUTS=()
    while IFS= read -r lt_line; do
        [[ -z "$lt_line" ]] && continue
        lt_idx="${lt_line%%:*}"
        LEVEL_TIMEOUTS[lt_idx]="${lt_line#*:}"
    done <<< "$level_lines"
    LAST_LEVEL=$(( ${#LEVEL_TIMEOUTS[@]} - 1 ))
    scan_timeout=$(read_scan_timeout)

    # ефективні ліміти/порти srv_* -- це тепер робота build_srv_table нижче
    # (окремо для ${TABLE_SRV} і кожної додаткової таблиці, кожна зі своїм
    # SUBDIR), тут більше не читаємо.

    trusted=$(list_elements    "$BASE_TRUSTED"    "${OVERRIDE_DIR}/trusted-extra.list")
    ignore=$(list_elements     "$BASE_IGNORE"     "${OVERRIDE_DIR}/ignore-extra.list")
    permanent=$(list_elements  "$BASE_PERMANENT"  "${OVERRIDE_DIR}/permanent-extra.list")
    trusted6=$(list_elements   "$BASE_TRUSTED6"   "${OVERRIDE_DIR}/trusted6-extra.list")
    ignore6=$(list_elements    "$BASE_IGNORE6"    "${OVERRIDE_DIR}/ignore6-extra.list")
    permanent6=$(list_elements "$BASE_PERMANENT6" "${OVERRIDE_DIR}/permanent6-extra.list")

    # forward-інтерфейси -- СПІЛЬНІ для ВСІХ таблиць (той самий перелік
    # docker-бриджів + extra_forward_ifaces), рахуємо один раз тут, ще до
    # побудови будь-якої з них. NO_DOCKER не означає "forward не
    # будується взагалі" -- лише "docker-бриджі автоматично не підхоплюються".
    # НЕ local -- читається в build_srv_table нижче.
    forward_ifaces=$( { [[ $NO_DOCKER -eq 0 ]] && get_docker_bridges; read_extra_forward_ifaces; } | sort -u)

    # =========================================================================
    # ${TABLE} -- драбина ескалації level*/scan (те, що лишилось тут після
    # винесення srv_* в окрему таблицю нижче)
    # =========================================================================

    # "add table" перед "delete table" — гарантує, що таблиця існує на момент
    # видалення (інакше на чистому хості, де таблиці ще нема, і "nft -c -f",
    # і сам "delete table" валяться з "No such file or directory")
    echo "add table ${TABLE}"
    echo "delete table ${TABLE}"
    echo "add table ${TABLE}"

    # --- статичні IPv4 сети ---
    echo "add set ${TABLE} trusted { type ipv4_addr; flags interval; auto-merge; comment \"Trusted Sources\"; }"
    [[ -n "$trusted" ]] && echo "add element ${TABLE} trusted { ${trusted} }"
    echo "add set ${TABLE} ignore { type ipv4_addr; flags interval; auto-merge; comment \"Excluded Sources\"; }"
    [[ -n "$ignore" ]] && echo "add element ${TABLE} ignore { ${ignore} }"
    echo "add set ${TABLE} permanentBlock { type ipv4_addr; flags interval; auto-merge; comment \"Permanent Block\"; }"
    [[ -n "$permanent" ]] && echo "add element ${TABLE} permanentBlock { ${permanent} }"

    # --- статичні IPv6 сети + level6_*/scan6 -- тільки якщо IPv6 не
    # вимкнено глобально (--no-ipv6 чи автовизначено); інакше жоден з цих
    # сетів узагалі не потрібен -- нема кому в них щось писати
    if [[ $NO_IPV6 -eq 0 ]]; then
        echo "add set ${TABLE} trusted6 { type ipv6_addr; flags interval; auto-merge; comment \"Trusted Sources\"; }"
        [[ -n "$trusted6" ]] && echo "add element ${TABLE} trusted6 { ${trusted6} }"
        echo "add set ${TABLE} ignore6 { type ipv6_addr; flags interval; auto-merge; comment \"Excluded Sources\"; }"
        [[ -n "$ignore6" ]] && echo "add element ${TABLE} ignore6 { ${ignore6} }"
        echo "add set ${TABLE} permanentBlock6 { type ipv6_addr; flags interval; auto-merge; comment \"Permanent Block\"; }"
        [[ -n "$permanent6" ]] && echo "add element ${TABLE} permanentBlock6 { ${permanent6} }"
        gen_level_sets ipv6_addr level6_
        echo "add set ${TABLE} scan6 { type ipv6_addr; size 65535; flags dynamic,timeout; timeout ${scan_timeout}; comment \"Scan Detect\"; }"
        emit_restore "${TABLE}" "scan6"
    fi

    # --- level0..level15 (ipv4 -- завжди) ---
    gen_level_sets ipv4_addr level
    echo "add set ${TABLE} scan { type ipv4_addr; size 65535; flags dynamic,timeout; timeout ${scan_timeout}; comment \"Scan Detect\"; }"
    emit_restore "${TABLE}" "scan"

    # --- ланцюги ---
    echo "add chain ${TABLE} input { type filter hook input priority ${priority}; }"

    # --- input: ipv4 ---
    gen_static_guard_rules "${TABLE}" input
    gen_level_rules input ip level scan

    # --- input: ipv6 (глобальний перемикач -- input не per-interface, тож
    # тонше за "усе або нічого" тут не буває) ---
    if [[ $NO_IPV6 -eq 0 ]]; then
        gen_static_guard6_rules "${TABLE}" input
        gen_level_rules input ip6 level6_ scan6
    fi

    # --- forward: тільки якщо є ХОЧ ОДИН інтерфейс для захисту (спільний
    # $forward_ifaces, порахований вище) ---
    if [[ -n "$forward_ifaces" ]]; then
        echo "add chain ${TABLE} forward { type filter hook forward priority ${priority}; }"

        local iface ifm
        while read -r iface; do
            [[ -z "$iface" ]] && continue
            ifm="iifname != ${iface} oifname ${iface} "

            gen_static_guard_rules "${TABLE}" forward "$ifm"
            gen_level_rules forward ip level scan "$ifm"

            # ipv6 для forward -- і глобально не вимкнено, і саме на ЦЬОМУ
            # інтерфейсі IPv6 увімкнено (кожен інтерфейс перевіряється окремо,
            # незалежно від сусідніх -- один без IPv6 не позначається на решті)
            if [[ $NO_IPV6 -eq 0 ]] && ipv6_enabled_for_iface "$iface"; then
                gen_static_guard6_rules "${TABLE}" forward "$ifm"
                gen_level_rules forward ip6 level6_ scan6 "$ifm"
            fi
        done <<< "$forward_ifaces"
    fi

    # =========================================================================
    # Захист протокол-груп (srv_*, meter-based) -- ГОЛОВНА ${TABLE_SRV} і всі
    # ДОДАТКОВІ srv-таблиці (discover_extra_srv_dirs, підкаталоги
    # ${OVERRIDE_DIR}). Кожна -- окрема build_srv_table (нижче): своя
    # table inet, свій priority (менший за ${priority}, у головної завжди
    # ${srv_priority}=priority-1, у додаткових -- read_extra_priority), свої
    # srv_ports/srv_timeouts; permanentBlock/trusted/ignore (і v6) ДУБЛЬОВАНІ
    # з тими самими елементами, що й у ${TABLE} вище -- return виходить лише
    # з ВЛАСНОГО chain, тож кожна таблиця має власні копії; єдине джерело
    # правди лишається те саме (override-файли, прочитані один раз вище).
    # =========================================================================

    build_srv_table "${TABLE_SRV}" "" "$srv_priority"

    local extra_dir
    while IFS= read -r extra_dir; do
        [[ -z "$extra_dir" ]] && continue
        build_srv_table "${TABLE_FAMILY} ${extra_dir}" "$extra_dir" "$(read_extra_priority "$extra_dir" "$priority")"
    done < <(discover_extra_srv_dirs)

    return 0
}

# --- --stop-fwd / --stop-fwd-docker ---

# Атомарно знімає ланцюг forward з УСІХ живих таблиць (одна мінітранзакція,
# теж через nft -c -f -> nft -f) -- input, усі сети й live-стан в жодній не
# чіпає. Щоб повернути forward -- достатньо звичайного запуску nft-scan-detector.
do_stop_fwd() {
    local tmpfile any=0 t
    tmpfile=$(mktemp /tmp/nft-scandetect.XXXXXX.nft)

    while IFS= read -r t; do
        if sudo nft list chain ${t} forward >/dev/null 2>&1; then
            echo "delete chain ${t} forward" >> "$tmpfile"
            any=1
        fi
    done < <(list_all_tables)

    if [[ $any -eq 0 ]]; then
        echo "Ланцюг forward відсутній в жодній таблиці -- нічого знімати." >&2
        rm -f "$tmpfile"
        return 0
    fi

    echo "Знімаю ланцюг forward (docker-правила усіх таблиць)..." >&2
    if ! sudo nft -c -f "$tmpfile"; then
        echo "Помилка синтаксису під час зняття forward -- нічого не чіпаю." >&2
        rm -f "$tmpfile"
        exit 1
    fi
    sudo nft -f "$tmpfile"
    rm -f "$tmpfile"
    echo "Ланцюг forward знято в усіх таблицях. input і всі сети (live-стан) лишились без змін." >&2
}

do_stop_docker() {
    echo "Зупиняю docker.socket, потім docker.service (у цьому порядку -- щоб" >&2
    echo "socket-activation не підняла docker.service назад)..." >&2
    sudo systemctl stop docker.socket
    sudo systemctl stop docker.service
}

# --- --stop ---

# Атомарно прибирає УСІ відомі таблиці (${TABLE}, ${TABLE_SRV}, і кожну
# додаткову srv-таблицю) із системи ПОВНІСТЮ (delete table -- і input, і
# forward, і всі сети йдуть разом з кожною). На відміну від do_stop_fwd, це
# залишає хост і docker-мережі зовсім без захисту. Live-стан кожної перед
# видаленням лягає у ЄДИНИЙ PENDING_STATE_FILE -- перший наступний звичайний
# запуск (systemctl start/restart чи просто nft-scan-detector без
# прапорців) підхопить його й відновить усі одразу.
do_stop_all() {
    local t existing=()
    while IFS= read -r t; do
        sudo nft list table ${t} >/dev/null 2>&1 && existing+=("$t")
    done < <(list_all_tables)

    if [[ ${#existing[@]} -eq 0 ]]; then
        echo "Жодної відомої таблиці немає -- нічого прибирати." >&2
        return 0
    fi

    sudo mkdir -p "$AUDIT_DIR"
    LIVE_STATE_FILE=$(mktemp /tmp/nft-scandetect.XXXXXX.state)
    for t in "${existing[@]}"; do
        capture_live_state "$t"
    done
    if [[ -s "$LIVE_STATE_FILE" ]]; then
        sudo cp "$LIVE_STATE_FILE" "$PENDING_STATE_FILE"
        echo "Live-стан усіх таблиць збережено -- відновиться при наступному запуску." >&2
    else
        sudo rm -f "$PENDING_STATE_FILE"
    fi
    rm -f "$LIVE_STATE_FILE"

    local tmpfile
    tmpfile=$(mktemp /tmp/nft-scandetect.XXXXXX.nft)
    for t in "${existing[@]}"; do
        echo "delete table ${t}" >> "$tmpfile"
    done

    echo "Прибираю таблиці (${existing[*]}) із системи повністю..." >&2
    if ! sudo nft -c -f "$tmpfile"; then
        echo "Помилка синтаксису під час видалення таблиць -- нічого не чіпаю." >&2
        rm -f "$tmpfile"
        exit 1
    fi
    sudo nft -f "$tmpfile"
    rm -f "$tmpfile"
    echo "Таблиці прибрано. Хост і docker-мережі БІЛЬШЕ НЕ захищені." >&2
    echo "Щоб повернути -- звичайний запуск nft-scan-detector (або systemctl start scan-detector.service)." >&2
}

# --- --init ---

do_init() {
    sudo mkdir -p "$OVERRIDE_DIR"
    seed_all_config_if_missing
    echo "Override-файли в ${OVERRIDE_DIR} на місці (досіяно відсутні вбудованими дефолтами)." >&2
    echo "Живу таблицю не чіпав -- запусти nft-scan-detector без прапорців, щоб застосувати." >&2
}

# ---------------------------------------------------------------------------

main() {
    sudo mkdir -p "$AUDIT_DIR"
    local ts tmpfile
    ts=$(date +%Y%m%d-%H%M%S)
    tmpfile=$(mktemp /tmp/nft-scandetect.XXXXXX.nft)
    LIVE_STATE_FILE=$(mktemp /tmp/nft-scandetect.XXXXXX.state)
    trap 'rm -f "${tmpfile:-}" "${LIVE_STATE_FILE:-}"' EXIT

    # Відкладений знімок від попереднього --stop (таблиці вже нема, знімати
    # живий стан нема звідки) -- пріоритетне джерело, одноразове споживання.
    # --reset-live-state ігнорує й прибирає його теж (явний запит почати з
    # чистого). Інакше -- звичний шлях: знімок ПЕРЕД перестворенням таблиці,
    # поки жива таблиця ще не займана.
    if [[ $RESET_LIVE_STATE -eq 0 ]] && [[ -s "$PENDING_STATE_FILE" ]]; then
        cp "$PENDING_STATE_FILE" "$LIVE_STATE_FILE"
        sudo rm -f "$PENDING_STATE_FILE"
        echo "Відновлюю live-стан із відкладеного знімка (залишеного попереднім --stop)." >&2
    else
        sudo rm -f "$PENDING_STATE_FILE"
        local t
        while IFS= read -r t; do
            capture_live_state "$t"
        done < <(list_all_tables)
    fi
    sudo cp "$LIVE_STATE_FILE" "${AUDIT_DIR}/live-state-${ts}.tsv"

    build_ruleset > "$tmpfile"
    sudo cp "$tmpfile" "${AUDIT_DIR}/ruleset-${ts}.nft"

    echo "Перевірка синтаксису..." >&2
    if ! sudo nft -c -f "$tmpfile"; then
        echo "Помилка синтаксису — таблиці НЕ чіпаю, поточний ruleset залишається без змін." >&2
        echo "Файл для аналізу: ${AUDIT_DIR}/ruleset-${ts}.nft" >&2
        exit 1
    fi

    echo "Застосовую атомарно..." >&2
    sudo nft -f "$tmpfile"

    local t2
    while IFS= read -r t2; do
        sudo nft list table ${t2}
    done < <(list_all_tables)
}

# Заповнюємо кеш discover_extra_srv_dirs ОДНИМ прямим викликом (без
# $(...)/<(...) -- ті форкають підшелл, і встановлений усередині кеш
# губився б одразу після завершення підшелла). Усі наступні виклики нижче
# (seed_all_config_if_missing, build_ruleset, list_all_tables) — вже через
# підстановки, але успадковують ЦЕЙ, уже заповнений кеш від форка, тож
# повторно каталог не сканують і попередження не дублюють.
discover_extra_srv_dirs >/dev/null

if [[ $STOP_FWD -eq 1 ]]; then
    do_stop_fwd
    [[ $STOP_FWD_DOCKER -eq 1 ]] && do_stop_docker
    exit 0
fi

if [[ $STOP_ALL -eq 1 ]]; then
    do_stop_all
    exit 0
fi

if [[ $INIT -eq 1 ]]; then
    do_init
    exit 0
fi

main
