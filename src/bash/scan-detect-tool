#!/bin/bash

# scan-detect-tool — керування IP-адресами у ВСІХ nft-таблицях проєкту:
# inet scanDetector (драбина level*/scan), inet srvProtector (захист
# протокол-груп, srv_*), і кожній додатковій srv-таблиці (підкаталог
# ${OVERRIDE_DIR}, див. nft-scan-detector --help / README).
#
# Працює в парі з nft-scan-detector: обидва скрипти вважають файли в
# /etc/nft-scandetect єдиним джерелом правди для trusted/ignore/permanentBlock,
# і однаково визначають перелік додаткових srv-таблиць (discover_extra_srv_dirs
# тут -- та сама логіка, що й у nft-scan-detector). Ця команда:
#   1. редагує відповідний *-extra.list файл (додає/видаляє рядок);
#   2. одразу застосовує ту саму зміну до ЖИВИХ таблиць через nft -- trusted/
#      ignore/permanentBlock (і v6-варіанти) ДУБЛЬОВАНІ в УСІХ таблицях
#      (nftables не дозволяє посилатись на сет з іншої таблиці), тож живе
#      застосування йде в усі одразу, щоб вони не розійшлись.
#
# Якщо список ще не має override-файлу (перший запуск на цьому списку),
# файл спершу бутстрапиться поточним станом ЖИВОГО сету (з scanDetector) --
# щоб заводські дефолти з nft-scan-detector (BASE_TRUSTED тощо) не загубились.
#
# Використання:
#   scan-detect-tool --delete IP           видалити IP звідусіль (живі сети в
#                                           УСІХ таблицях + будь-який
#                                           override-файл, де він є)
#   scan-detect-tool --add-ignore IP       додати в ignore/ignore6 (в усіх таблицях)
#   scan-detect-tool --add-trusted IP      додати в trusted/trusted6 (в усіх таблицях)
#   scan-detect-tool --add-permanent IP    додати в permanentBlock/permanentBlock6
#                                           (в усіх таблицях)
#   scan-detect-tool --list IP             показати живі сети (в усіх таблицях) +
#                                           override-файли, де є IP
#   scan-detect-tool --show                вивести повністю УСІ відомі таблиці
#                                           (inet scanDetector, inet srvProtector,
#                                           і кожну додаткову srv-таблицю)
#   scan-detect-tool --set-priority N      перевизначити пріоритет hook'ів input/forward
#                                           scanDetector (застосовується рестартом
#                                           scan-detector.service, не "живим" add
#                                           element); srvProtector -- завжди N-1,
#                                           окремо не задається
#   scan-detect-tool --set-table-name NAME     перевизначити назву scanDetector
#                                               (дефолт "scanDetector"); так само
#                                               рестартом, і додатково прибирає
#                                               стару таблицю
#   scan-detect-tool --set-table-name-srv NAME те саме для srvProtector (дефолт
#                                               "srvProtector")
#   scan-detect-tool --init                досіяти відсутні override-файли дефолтами
#                                           (делегує nft-scan-detector --init)
#   scan-detect-tool --dry-run ...         показати команди, нічого не змінюючи
#
# Вимоги: nft, jq

set -euo pipefail

TABLE_FAMILY="inet"
DEFAULT_TABLE_NAME="scanDetector"
DEFAULT_TABLE_NAME_SRV="srvProtector"
OVERRIDE_DIR="/etc/nft-scandetect"
DRY_RUN=0

# Читає ${OVERRIDE_DIR}/table_name(_srv) -- той самий формат і фолбек-логіка,
# що й у nft-scan-detector (read_table_name(_srv) там) -- обидва скрипти
# мають бачити ту саму назву таблиці, інакше редагування/показ підуть не
# в ту таблицю.
read_table_name() {
    local file="${OVERRIDE_DIR}/table_name" raw
    if [[ -f "$file" ]]; then
        raw=$(head -1 "$file" | tr -d '[:space:]')
        if [[ "$raw" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            echo "$raw"
            return 0
        fi
        echo "УВАГА: $file містить нелегітимну назву таблиці ('$raw') -- використовую дефолт ${DEFAULT_TABLE_NAME}." >&2
    fi
    echo "$DEFAULT_TABLE_NAME"
}

read_table_name_srv() {
    local file="${OVERRIDE_DIR}/table_name_srv" raw
    if [[ -f "$file" ]]; then
        raw=$(head -1 "$file" | tr -d '[:space:]')
        if [[ "$raw" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            echo "$raw"
            return 0
        fi
        echo "УВАГА: $file містить нелегітимну назву таблиці ('$raw') -- використовую дефолт ${DEFAULT_TABLE_NAME_SRV}." >&2
    fi
    echo "$DEFAULT_TABLE_NAME_SRV"
}

TABLE_NAME="$(read_table_name)"
TABLE_NAME_SRV="$(read_table_name_srv)"

# discover_extra_srv_dirs -- та сама логіка, що й в nft-scan-detector
# (discover_extra_srv_dirs там): кожен підкаталог ${OVERRIDE_DIR} -- окрема
# додаткова srv-таблиця. Друкує валідні назви по рядку. Обидва скрипти
# мають бачити той самий перелік -- інакше scan-detect-tool промине живу
# зміну в таблиці, про яку не знає.
discover_extra_srv_dirs() {
    local d name
    [[ -d "$OVERRIDE_DIR" ]] || return 0
    for d in "${OVERRIDE_DIR}"/*/; do
        [[ -d "$d" ]] || continue
        name="$(basename "$d")"
        if [[ ! "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            echo "УВАГА: каталог ${d} -- не легітимний nft-ідентифікатор, пропускаю як додаткову srv-таблицю." >&2
            continue
        fi
        if [[ "$name" == "$TABLE_NAME" || "$name" == "$TABLE_NAME_SRV" ]]; then
            echo "УВАГА: каталог ${d} збігається з назвою вже наявної таблиці (${TABLE_NAME}/${TABLE_NAME_SRV}), пропускаю." >&2
            continue
        fi
        echo "$name"
    done | sort -u
}

# ALL_TABLE_NAMES -- усі відомі таблиці (scanDetector, srvProtector, і
# кожна додаткова), масив назв (без родини). Рахується один раз тут --
# усі команди нижче (--show/--add-*/--list/--delete) ітеруються по ньому
# замість жорстко прописаних TABLE_NAME/TABLE_NAME_SRV.
ALL_TABLE_NAMES=("$TABLE_NAME" "$TABLE_NAME_SRV")
while IFS= read -r _extra; do
    [[ -z "$_extra" ]] && continue
    ALL_TABLE_NAMES+=("$_extra")
done < <(discover_extra_srv_dirs)

usage() {
    cat <<EOF
Використання: $(basename "$0") [--dry-run] КОМАНДА АРГУМЕНТ

Команди:
  --delete IP           Видалити IP з усіх живих сетів УСІХ таблиць і з усіх
                         override-файлів, де він знайдений
  --add-ignore IP        Додати IP в ignore (ignore6 для IPv6) -- в усіх таблицях
  --add-trusted IP       Додати IP в trusted (trusted6 для IPv6) -- в усіх таблицях
  --add-permanent IP     Додати IP в permanentBlock (permanentBlock6 для IPv6)
                         -- в усіх таблицях
  --list IP              Показати живі сети (в усіх таблицях) та override-файли,
                         де присутній IP
  --show                 Вивести повністю УСІ живі таблиці (nft list table
                         inet scanDetector; inet srvProtector; і кожну
                         додаткову srv-таблицю) -- усі сети й правила як є зараз
  --set-priority N       Перевизначити пріоритет hook'ів input/forward
                         scanDetector (ціле число, дефолт -50). На відміну
                         від інших команд застосовується не одразу в живих
                         сетах, а рестартом scan-detector.service (потрібна
                         повна перегенерація). Пріоритет srvProtector окремо
                         не задається -- завжди N-1 (рахується автоматично).
  --set-table-name NAME  Перевизначити назву таблиці scanDetector (дефолт
                         "scanDetector"). Так само повна перегенерація
                         рестартом scan-detector.service, і додатково
                         прибирає стару таблицю під попередньою назвою (nft
                         не вміє перейменувати таблицю "на місці").
  --set-table-name-srv NAME  Те саме, для таблиці srvProtector (дефолт
                         "srvProtector").
  --init                 Досіяти відсутні override-файли вбудованими
                         дефолтами (делегує nft-scan-detector --init).
                         Живих таблиць не чіпає, аргументу не потребує.

Додаткові srv-таблиці (окремо від srvProtector) -- підкаталоги
${OVERRIDE_DIR}, кожен зі своїми srv_ports/srv_timeouts/priority; ця
команда САМА їх виявляє (той самий перелік, що й nft-scan-detector) і бере
до уваги в усіх командах вище автоматично -- окремих опцій для керування
самими підкаталогами тут нема (створюються вручну, mkdir/rmdir; вміст
srv_ports/srv_timeouts/priority -- звичайним редагуванням файлів).

Опції:
  --dry-run              Показати команди/дії, нічого не застосовуючи
  -h, --help              Ця довідка
EOF
    exit 1
}

is_ipv6() {
    [[ "$1" == *:* ]]
}

validate_ip() {
    local ip="$1"
    if is_ipv6 "$ip"; then
        [[ "$ip" =~ ^[0-9a-fA-F:]+(/[0-9]{1,3})?$ ]] || { echo "Помилка: '$ip' не схоже на IPv6-адресу" >&2; exit 1; }
    else
        [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}(/[0-9]{1,2})?$ ]] || { echo "Помилка: '$ip' не схоже на IPv4-адресу" >&2; exit 1; }
    fi
}

# Виконує або друкує nft-команду залежно від --dry-run
run_nft() {
    if [[ $DRY_RUN -eq 1 ]]; then
        echo "(dry-run) nft $*"
    else
        sudo nft "$@"
    fi
}

# --- відповідність kind(+родина) -> назва сету в nft / назва override-файлу ---
# kind: trusted | ignore | permanent

set_name_for() {
    local kind="$1" ip="$2"
    case "$kind" in
        trusted)   is_ipv6 "$ip" && echo trusted6         || echo trusted ;;
        ignore)    is_ipv6 "$ip" && echo ignore6          || echo ignore ;;
        permanent) is_ipv6 "$ip" && echo permanentBlock6  || echo permanentBlock ;;
        *) echo "Внутрішня помилка: невідомий kind '$kind'" >&2; exit 1 ;;
    esac
}

extra_file_for() {
    local kind="$1" ip="$2"
    case "$kind" in
        trusted)   is_ipv6 "$ip" && echo "${OVERRIDE_DIR}/trusted6-extra.list"   || echo "${OVERRIDE_DIR}/trusted-extra.list" ;;
        ignore)    is_ipv6 "$ip" && echo "${OVERRIDE_DIR}/ignore6-extra.list"    || echo "${OVERRIDE_DIR}/ignore-extra.list" ;;
        permanent) is_ipv6 "$ip" && echo "${OVERRIDE_DIR}/permanent6-extra.list" || echo "${OVERRIDE_DIR}/permanent-extra.list" ;;
        *) echo "Внутрішня помилка: невідомий kind '$kind'" >&2; exit 1 ;;
    esac
}

# Список усіх шести override-файлів (для --delete і --list)
all_extra_files() {
    printf '%s\n' \
        "${OVERRIDE_DIR}/trusted-extra.list" \
        "${OVERRIDE_DIR}/ignore-extra.list" \
        "${OVERRIDE_DIR}/permanent-extra.list" \
        "${OVERRIDE_DIR}/trusted6-extra.list" \
        "${OVERRIDE_DIR}/ignore6-extra.list" \
        "${OVERRIDE_DIR}/permanent6-extra.list"
}

# Витягує елементи ЖИВОГО (статичного, interval) сету у вигляді "по одному
# значенню на рядок" -- враховує і прості значення, і CIDR-об'єкти {"prefix":...}.
# Читає з ${TABLE_NAME} (scanDetector) -- цього досить для бутстрапу:
# trusted/ignore/permanentBlock ідентичні в УСІХ таблицях (та сама
# генерація з тих самих override-файлів), тож не важливо, з якої саме
# зняти початковий стан.
live_set_elements() {
    local set_name="$1"
    sudo nft -j list set "${TABLE_FAMILY}" "${TABLE_NAME}" "$set_name" 2>/dev/null | jq -r '
        .nftables[]? | select(.set?) | .set.elem[]? |
        if type=="object" then
            if has("prefix") then "\(.prefix.addr)/\(.prefix.len)" else empty end
        else .
        end
    ' 2>/dev/null || true
}

# Якщо override-файл ще не існує -- створює його з поточного стану ЖИВОГО
# сету (щоб дефолти nft-scan-detector не загубились при першому редагуванні).
ensure_bootstrapped() {
    local set_name="$1" file="$2"
    [[ -f "$file" ]] && return 0

    sudo mkdir -p "$OVERRIDE_DIR"

    if [[ $DRY_RUN -eq 1 ]]; then
        echo "(dry-run) файл $file відсутній — бутстрапнув би його поточним станом сету $set_name" >&2
        return 0
    fi

    echo "Файл $file відсутній — ініціалізую поточним станом сету $set_name (щоб не загубити дефолти)." >&2
    local existing
    existing=$(live_set_elements "$set_name")
    {
        echo "# Ініціалізовано scan-detect-tool $(date '+%Y-%m-%d %H:%M:%S') зі стану живого сету ${set_name}"
        if [[ -n "$existing" ]]; then
            printf '%s\n' "$existing"
        fi
    } | sudo tee "$file" >/dev/null
}

# Дописує IP у файл, якщо його там ще нема (порівняння точне, по всьому рядку)
append_if_missing() {
    local file="$1" value="$2"
    if [[ -f "$file" ]] && grep -qxF -- "$value" "$file" 2>/dev/null; then
        echo "  (вже є в $file — файл не змінюю)"
        return 0
    fi
    if [[ $DRY_RUN -eq 1 ]]; then
        echo "(dry-run) echo '$value' >> $file"
    else
        echo "$value" | sudo tee -a "$file" >/dev/null
        echo "  + дописано в $file"
    fi
}

# Видаляє рядок з файлу, якщо він там є (атомарно, без sed-екранування)
remove_if_present() {
    local file="$1" value="$2"
    [[ -f "$file" ]] || return 0
    grep -qxF -- "$value" "$file" 2>/dev/null || return 0

    if [[ $DRY_RUN -eq 1 ]]; then
        echo "(dry-run) видалив би рядок '$value' з $file"
        return 0
    fi
    local tmp
    tmp=$(mktemp)
    grep -vxF -- "$value" "$file" | sudo tee "$tmp" >/dev/null
    sudo install -m "$(stat -c %a "$file")" -o "$(stat -c %U "$file")" -g "$(stat -c %G "$file")" "$tmp" "$file"
    rm -f "$tmp"
    echo "  - видалено з $file"
}

# --- пошук IP у живих сетах УСІХ відомих таблиць (level*/scan* у
# scanDetector, srv_block/srv6_block і дубльовані trusted/ignore/permanent*
# у кожній srv-таблиці) -- друкує "TABLE_NAME<TAB>SET_NAME" по рядку, щоб
# виклик (cmd_list/cmd_delete) знав, у якій саме таблиці шукати/видаляти
# елемент.
find_live_sets_with_ip() {
    local ip="$1" tname
    for tname in "${ALL_TABLE_NAMES[@]}"; do
        sudo nft -j list table "${TABLE_FAMILY}" "$tname" 2>/dev/null | jq -r --arg ip "$ip" --arg t "$tname" '
            .nftables[]
            | select(.set?)
            | .set
            | select(
                .elem? and any(.elem[]?;
                    (if type=="object" then
                        (.elem.val // (if has("prefix") then "\(.prefix.addr)/\(.prefix.len)" else empty end))
                     else .
                     end) == $ip)
              )
            | "\($t)\t\(.name)"
        '
    done
}

cmd_list() {
    local ip="$1"
    validate_ip "$ip"

    local sets
    sets=$(find_live_sets_with_ip "$ip")
    if [[ -z "$sets" ]]; then
        echo "IP $ip не знайдено в жодному живому сеті жодної з таблиць (${ALL_TABLE_NAMES[*]})."
    else
        echo "IP $ip знайдено в живих сетах:"
        echo "$sets" | awk -F'\t' '{print "  - " $1 ": " $2}'
    fi

    echo "Присутність в override-файлах:"
    local found_any=0 f
    while IFS= read -r f; do
        if [[ -f "$f" ]] && grep -qxF -- "$ip" "$f" 2>/dev/null; then
            echo "  - $f"
            found_any=1
        fi
    done < <(all_extra_files)
    [[ $found_any -eq 0 ]] && echo "  (ніде)"
    return 0
}

# cmd_show -- виводить nft list table для УСІХ відомих таблиць як є (без
# --dry-run особливостей: команда й так нічого не змінює, лише читає)
cmd_show() {
    local tname
    for tname in "${ALL_TABLE_NAMES[@]}"; do
        sudo nft list table "${TABLE_FAMILY}" "${tname}"
    done
}

cmd_delete() {
    local ip="$1"
    validate_ip "$ip"

    local sets
    sets=$(find_live_sets_with_ip "$ip")
    if [[ -z "$sets" ]]; then
        echo "IP $ip не знайдено в жодному живому сеті."
    else
        echo "Видаляю $ip з живих сетів:"
        while IFS=$'\t' read -r tname set_name; do
            [[ -z "$set_name" ]] && continue
            echo "  - $tname: $set_name"
            run_nft delete element "${TABLE_FAMILY}" "$tname" "$set_name" "{ $ip }"
        done <<< "$sets"
    fi

    echo "Прибираю $ip з override-файлів (якщо є) -- щоб не повернувся після перебудови:"
    local f any_removed=0
    while IFS= read -r f; do
        if [[ -f "$f" ]] && grep -qxF -- "$ip" "$f" 2>/dev/null; then
            remove_if_present "$f" "$ip"
            any_removed=1
        fi
    done < <(all_extra_files)
    [[ $any_removed -eq 0 ]] && echo "  (у файлах не знайдено)"
    return 0
}

# cmd_add KIND IP  -- KIND: trusted | ignore | permanent
# trusted/ignore/permanentBlock (і v6-варіанти) ДУБЛЬОВАНІ в УСІХ таблицях
# (nftables не дозволяє посилатись на сет з іншої таблиці) -- живе
# застосування йде в усі одразу, інакше вони розійдуться (IP довірений у
# scanDetector, але й далі rate/over-лімітується в srvProtector чи будь-якій
# додатковій srv-таблиці).
cmd_add() {
    local kind="$1" ip="$2"
    validate_ip "$ip"

    local set_name file
    set_name=$(set_name_for "$kind" "$ip")
    file=$(extra_file_for "$kind" "$ip")

    ensure_bootstrapped "$set_name" "$file"

    echo "Додаю $ip у $kind ($set_name):"
    append_if_missing "$file" "$ip"

    local tname
    for tname in "${ALL_TABLE_NAMES[@]}"; do
        run_nft add element "${TABLE_FAMILY}" "$tname" "$set_name" "{ $ip }" \
            || echo "УВАГА: не вдалось застосувати наживо в inet $tname / $set_name (таблиця/сет ще не створені? запустіть nft-scan-detector)." >&2
    done
}

# cmd_set_priority VALUE -- перевизначає пріоритет hook'ів input/forward
# (${OVERRIDE_DIR}/priority, керується так само nft-scan-detector'ом --
# див. read_priority там). На відміну від --add-*, це не "живий" add
# element: пріоритет міняє сам hook, застосувати можна лише повною
# перегенерацією ruleset, тож тут -- рестарт scan-detector.service.
cmd_set_priority() {
    local raw="$1" value file
    value="${raw//[[:space:]]/}"
    if [[ ! "$value" =~ ^-?[0-9]+$ ]]; then
        echo "Помилка: '$raw' не схоже на ціле число (пріоритет хука)." >&2
        exit 1
    fi
    file="${OVERRIDE_DIR}/priority"

    if [[ $DRY_RUN -eq 1 ]]; then
        echo "(dry-run) echo '$value' > $file"
        echo "(dry-run) systemctl restart scan-detector.service"
        return 0
    fi

    sudo mkdir -p "$OVERRIDE_DIR"
    echo "$value" | sudo tee "$file" >/dev/null
    echo "Пріоритет збережено: $value ($file)."

    echo "Пріоритет міняє сам hook -- застосовується лише повною перегенерацією." >&2
    echo "Пріоритет srvProtector зміниться разом (завжди $((value - 1)), N-1 від scanDetector)." >&2
    echo "Рестартую scan-detector.service..." >&2
    if sudo systemctl restart scan-detector.service 2>/dev/null; then
        echo "Застосовано."
    else
        echo "УВАГА: не вдалось перезапустити scan-detector.service -- застосуйте вручну: sudo nft-scan-detector" >&2
    fi
}

# _set_table_name_generic FILE OLD_NAME NEW_VALUE LABEL -- спільна логіка
# для cmd_set_table_name і cmd_set_table_name_srv (та сама процедура для
# обох таблиць): записати override-файл, прибрати СТАРУ таблицю (nft не
# вміє перейменувати "на місці" -- звичайний перезапуск створив би НОВУ
# таблицю під новою назвою поруч зі СТАРОЮ, та лишилась би назавжди активна
# й далі фільтрувала б трафік під забутою назвою), рестартнути
# scan-detector.service. LABEL -- людський опис для повідомлень
# ("scanDetector"/"srvProtector").
_set_table_name_generic() {
    local file="$1" old_name="$2" value="$3" label="$4"

    if [[ "$value" == "$old_name" ]]; then
        echo "Назва таблиці $label вже '$value' -- нічого не змінюю."
        return 0
    fi

    if [[ $DRY_RUN -eq 1 ]]; then
        echo "(dry-run) echo '$value' > $file"
        echo "(dry-run) nft delete table ${TABLE_FAMILY} ${old_name}   # стара таблиця $label, якщо існує"
        echo "(dry-run) systemctl restart scan-detector.service"
        return 0
    fi

    sudo mkdir -p "$OVERRIDE_DIR"
    echo "$value" | sudo tee "$file" >/dev/null
    echo "Нову назву таблиці $label збережено: $value ($file)."

    echo "Назва таблиці міняє саму nft-таблицю -- це не \"живий\" add element," >&2
    echo "а повна перегенерація. Прибираю стару таблицю ${TABLE_FAMILY} ${old_name}, якщо є..." >&2
    if sudo nft list table "${TABLE_FAMILY}" "$old_name" >/dev/null 2>&1; then
        if sudo nft delete table "${TABLE_FAMILY}" "$old_name"; then
            echo "Стару таблицю ${TABLE_FAMILY} ${old_name} видалено." >&2
        else
            echo "УВАГА: не вдалось видалити стару таблицю ${TABLE_FAMILY} ${old_name} -- приберіть вручну (sudo nft delete table ${TABLE_FAMILY} ${old_name})." >&2
        fi
    else
        echo "Старої таблиці ${TABLE_FAMILY} ${old_name} і так нема -- нічого прибирати." >&2
    fi

    echo "Рестартую scan-detector.service..." >&2
    if sudo systemctl restart scan-detector.service 2>/dev/null; then
        echo "Застосовано."
    else
        echo "УВАГА: не вдалось перезапустити scan-detector.service -- застосуйте вручну: sudo nft-scan-detector" >&2
    fi
}

# _name_collides NAME EXCLUDE -- true, якщо NAME збігається з будь-якою вже
# відомою назвою таблиці (ALL_TABLE_NAMES: scanDetector, srvProtector, і
# кожна додаткова), крім EXCLUDE (власна поточна назва таблиці, яку саме
# перейменовуємо -- на неї своя окрема "нічого не змінюю" гілка нижче).
_name_collides() {
    local name="$1" exclude="$2" t
    for t in "${ALL_TABLE_NAMES[@]}"; do
        [[ "$t" == "$exclude" ]] && continue
        [[ "$t" == "$name" ]] && return 0
    done
    return 1
}

# cmd_set_table_name NAME -- перевизначає назву таблиці scanDetector
# (${OVERRIDE_DIR}/table_name).
cmd_set_table_name() {
    local raw="$1" value
    value="${raw//[[:space:]]/}"
    if [[ ! "$value" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
        echo "Помилка: '$raw' не схоже на легітимну назву nft-таблиці (літери/цифри/підкреслення, не з цифри)." >&2
        exit 1
    fi
    if _name_collides "$value" "$TABLE_NAME"; then
        echo "Помилка: '$value' уже назва іншої відомої таблиці (srvProtector чи додаткової) -- назви не можуть збігатися." >&2
        exit 1
    fi
    _set_table_name_generic "${OVERRIDE_DIR}/table_name" "$TABLE_NAME" "$value" "scanDetector"
}

# cmd_set_table_name_srv NAME -- те саме, для таблиці srvProtector
# (${OVERRIDE_DIR}/table_name_srv).
cmd_set_table_name_srv() {
    local raw="$1" value
    value="${raw//[[:space:]]/}"
    if [[ ! "$value" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
        echo "Помилка: '$raw' не схоже на легітимну назву nft-таблиці (літери/цифри/підкреслення, не з цифри)." >&2
        exit 1
    fi
    if _name_collides "$value" "$TABLE_NAME_SRV"; then
        echo "Помилка: '$value' уже назва іншої відомої таблиці (scanDetector чи додаткової) -- назви не можуть збігатися." >&2
        exit 1
    fi
    _set_table_name_generic "${OVERRIDE_DIR}/table_name_srv" "$TABLE_NAME_SRV" "$value" "srvProtector"
}

# cmd_init -- тонка обгортка над nft-scan-detector --init: сіє відсутні
# override-файли вбудованими дефолтами, живої таблиці не чіпає. Логіка
# сідінгу навмисно живе тільки в nft-scan-detector, щоб не дублювати її тут.
cmd_init() {
    if [[ $DRY_RUN -eq 1 ]]; then
        echo "(dry-run) nft-scan-detector --init"
        return 0
    fi
    sudo nft-scan-detector --init
}

# --- разбір аргументів ---

[[ $# -eq 0 ]] && usage

ACTION=""
ARG=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --delete)
            ACTION="delete"; ARG="${2:-}"; shift 2 ;;
        --add-ignore)
            ACTION="add-ignore"; ARG="${2:-}"; shift 2 ;;
        --add-trusted)
            ACTION="add-trusted"; ARG="${2:-}"; shift 2 ;;
        --add-permanent)
            ACTION="add-permanent"; ARG="${2:-}"; shift 2 ;;
        --list)
            ACTION="list"; ARG="${2:-}"; shift 2 ;;
        --show)
            ACTION="show"; shift ;;
        --set-priority)
            ACTION="set-priority"; ARG="${2:-}"; shift 2 ;;
        --set-table-name)
            ACTION="set-table-name"; ARG="${2:-}"; shift 2 ;;
        --set-table-name-srv)
            ACTION="set-table-name-srv"; ARG="${2:-}"; shift 2 ;;
        --init)
            ACTION="init"; shift ;;
        --dry-run)
            DRY_RUN=1; shift ;;
        -h|--help)
            usage ;;
        *)
            echo "Невідома опція: $1" >&2
            usage ;;
    esac
done

if [[ -z "$ACTION" ]] || { [[ "$ACTION" != "init" ]] && [[ "$ACTION" != "show" ]] && [[ -z "$ARG" ]]; }; then
    echo "Помилка: не вказано команду або аргумент (IP-адресу чи значення)." >&2
    usage
fi

if ! command -v jq >/dev/null 2>&1; then
    echo "Помилка: потрібен jq (apt install jq)." >&2
    exit 1
fi

case "$ACTION" in
    delete)        cmd_delete "$ARG" ;;
    add-ignore)    cmd_add ignore    "$ARG" ;;
    add-trusted)   cmd_add trusted   "$ARG" ;;
    add-permanent) cmd_add permanent "$ARG" ;;
    list)          cmd_list "$ARG" ;;
    show)          cmd_show ;;
    set-priority)  cmd_set_priority "$ARG" ;;
    set-table-name) cmd_set_table_name "$ARG" ;;
    set-table-name-srv) cmd_set_table_name_srv "$ARG" ;;
    init)          cmd_init ;;
esac
